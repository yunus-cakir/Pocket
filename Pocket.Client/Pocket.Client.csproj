<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="Version.props" />

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Pocket.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>Pocket</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.yunuscakir.pocket.client</ApplicationId>

		<!-- Android Debug builds install as a separate app (own sandbox: DB, Preferences, media),
		     so they can sit next to the signed Release APK without sharing data. -->
		<ApplicationId Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">com.yunuscakir.pocket.client.debug</ApplicationId>
		<ApplicationTitle Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">Pocket (Debug)</ApplicationTitle>

		<!-- Versions: see Version.props and Build/ApkVersioning.ps1 -->
		<ApplicationDisplayVersion>$(PocketVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>$(PocketBuildNumber)</ApplicationVersion>

		<!-- Release Android builds produce a signed APK (sideloaded, not Play Store). -->
		<AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">apk</AndroidPackageFormat>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- Android adaptive icons show only the center 72dp of the 108dp layer, so Android uses a
		     pre-padded copy with the artwork at 0.68 scale (same ratio Locket uses). ForegroundScale
		     is ignored by Resizetizer for raster foregrounds, hence the separate file. -->
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
		          Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon_fg_android.png" Color="#6085AD" />
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'"
		          Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon_fg.png" Color="#6085AD" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.2" />
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
	</ItemGroup>

	<!-- CameraX (AndroidX Camera, built on Camera2) for the Android camera handler -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
		<!-- Align the Ktx companions with the newer Fragment / Collection that CameraX pulls in (NU1608) -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pocket.Shared\Pocket.Shared.csproj" />
	</ItemGroup>

	<!--
		Signed Release APK versioning + distribution (Windows only).
		Before the manifest is generated: resolve the next version/build (Patch+1 if client sources changed).
		After signing: copy "Pocket vX.Y.Z-bN (MM-dd).apk" to Desktop\Pocket and to Download/Pocket on
		connected physical Android devices, then persist the new state to Version.props.
	-->
	<PropertyGroup>
		<_PocketApkVersioning Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(AndroidPackageFormat)' == 'apk' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and $([MSBuild]::IsOSPlatform('windows'))">true</_PocketApkVersioning>
		<_PocketVersioningScript>powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Build\ApkVersioning.ps1&quot;</_PocketVersioningScript>
	</PropertyGroup>

	<Target Name="PocketResolveApkVersion" BeforeTargets="_GetAndroidPackageName" Condition="'$(_PocketApkVersioning)' == 'true' and '$(_PocketResolvedVersion)' == ''">
		<Exec Command="$(_PocketVersioningScript) -Mode Resolve" ConsoleToMSBuild="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_PocketResolveOutput" />
		</Exec>
		<PropertyGroup>
			<_PocketResolveLine>$([System.Text.RegularExpressions.Regex]::Match('$(_PocketResolveOutput)', '\d+\.\d+\.\d+\|\d+\|[0-9a-f]*').Value)</_PocketResolveLine>
			<_PocketResolvedVersion>$(_PocketResolveLine.Split('|')[0])</_PocketResolvedVersion>
			<_PocketResolvedBuild>$(_PocketResolveLine.Split('|')[1])</_PocketResolvedBuild>
			<_PocketResolvedFingerprint>$(_PocketResolveLine.Split('|')[2])</_PocketResolvedFingerprint>
			<ApplicationDisplayVersion>$(_PocketResolvedVersion)</ApplicationDisplayVersion>
			<ApplicationVersion>$(_PocketResolvedBuild)</ApplicationVersion>
		</PropertyGroup>
		<Error Condition="'$(_PocketResolveLine)' == ''" Text="ApkVersioning.ps1 -Mode Resolve returned no version: $(_PocketResolveOutput)" />
		<Message Importance="high" Text="Pocket APK version: v$(_PocketResolvedVersion)-b$(_PocketResolvedBuild)" />
	</Target>

	<Target Name="PocketExportSignedApk" AfterTargets="_Sign" Condition="'$(_PocketApkVersioning)' == 'true' and '$(_PocketResolvedVersion)' != '' and '$(_PocketApkExported)' != 'true'">
		<Exec Command="$(_PocketVersioningScript) -Mode Export -ApkPath &quot;$(ApkFileSigned)&quot; -Version $(_PocketResolvedVersion) -Build $(_PocketResolvedBuild) -SourceFingerprint &quot;$(_PocketResolvedFingerprint)&quot;" StandardOutputImportance="high" />
		<PropertyGroup>
			<_PocketApkExported>true</_PocketApkExported>
		</PropertyGroup>
	</Target>

</Project>
