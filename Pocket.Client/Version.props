<Project>
	<!--
		App version, managed by Build/ApkVersioning.ps1. Edit by hand only to reset the scheme.
		  PocketVersion           Major.Minor.Patch. Merge into main -> Minor+1 (Patch=0);
		                          a signed Release APK built from changed client sources -> Patch+1.
		  PocketBuildNumber       Increments on every signed Release APK (the "bX" suffix and Android versionCode).
		  PocketSourceFingerprint Hash of Pocket.Client + Pocket.Shared at the last version change; used to detect new changes.
	-->
	<PropertyGroup>
		<PocketVersion>1.0.1</PocketVersion>
		<PocketBuildNumber>3</PocketBuildNumber>
		<PocketSourceFingerprint>d43d447a8a7cda0f6a1433dd062732083956b884</PocketSourceFingerprint>
	</PropertyGroup>
</Project>
