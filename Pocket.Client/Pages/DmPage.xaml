        <!-- MESSAGE LONG-PRESS ACTION SHEET OVERLAY                        -->
        <!-- ============================================================== -->
        <Grid x:Name="MessageActionsOverlayGrid"
              Grid.Row="0"
              Grid.RowSpan="4"
              ZIndex="25"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <BoxView x:Name="MessageActionsBackdrop"
                     BackgroundColor="#78000000"
                     Color="#78000000"
                     Opacity="0"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMessageActionsBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="MessageActionsSheetCard"
                    VerticalOptions="End"
                    HorizontalOptions="Fill"
                    TranslationY="280"
                    BackgroundColor="#202022"
                    StrokeShape="RoundRectangle 28,28,0,0"
                    StrokeThickness="0"
                    Padding="0,12,0,22">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                    <PanGestureRecognizer PanUpdated="OnMessageActionsSheetPanUpdated" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Grid Padding="20,16" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CopySelectedMessageCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="Copy text"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>

                    <Grid Padding="20,16" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteSelectedMessageCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding SelectedMessageDeleteLabel}"
                               TextColor="#FF453A"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>

                    <Grid Padding="20,16" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseMessageActionsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="Cancel"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

