<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:Pocket.Client.PageModels"
             xmlns:models="clr-namespace:Pocket.Client.Models"
             xmlns:controls="clr-namespace:Pocket.Client.Controls"
             x:Class="Pocket.Client.Pages.DmPage"
             x:DataType="pm:DmPageModel"
             Title="Direct Messages"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" BackgroundColor="#000000">

        <!-- Row 0: Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="42, *, 42" Padding="16,14,16,10" BackgroundColor="#000000">
            <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Grid.GestureRecognizers>
                <Path Stroke="#A1A1AA"
                      StrokeThickness="2.2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Data="M15,6 L3,6 M8,1 L3,6 L8,11" />
            </Grid>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                <Label Text="{Binding FriendDisplayName}"
                       TextColor="#FFFFFF"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="🔒 E2EE • Incognito"
                       TextColor="#8E8E93"
                       FontFamily="OpenSansSemibold"
                       FontSize="11"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <BoxView Grid.Column="2" BackgroundColor="Transparent" Color="Transparent" />
        </Grid>

        <!-- Row 1: Messages CollectionView -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesCollectionView"
                        ItemsSource="{Binding Messages}"
                        Margin="12,8"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="32">
                    <Label Text="Send a message"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Messages and reactions are end-to-end encrypted."
                           TextColor="#8E8E93"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DirectMessage">
                    <Grid Padding="4,5">
                        <Border HorizontalOptions="{Binding BubbleAlignment}"
                                BackgroundColor="{Binding BubbleColor}"
                                Stroke="#2C2C2E"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="14,10"
                                MaximumWidthRequest="300">
                            <VerticalStackLayout Spacing="6">

                                <!-- Threaded Photo Preview (BR-302) -->
                                <Border IsVisible="{Binding HasMediaReference}"
                                        BackgroundColor="#141414"
                                        Stroke="#3A3A3C"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="8">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                        <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="0">
                                            <Image Source="{Binding ReferencedPostPath}" Aspect="AspectFill" WidthRequest="48" HeightRequest="48" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="Replied to photo" TextColor="#FFB800" FontFamily="OpenSansSemibold" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="{Binding ReferencedPostCaption}" TextColor="#FFFFFF" FontSize="12" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <!-- Emoji Reaction -->
                                <Label IsVisible="{Binding HasReaction}"
                                       Text="{Binding ReactionEmoji}"
                                       FontSize="32"
                                       HorizontalOptions="Start" />

                                <!-- Message Text -->
                                <Label IsVisible="{Binding HasText}"
                                       Text="{Binding TextContent}"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansRegular"
                                       FontSize="15" />

                                <!-- Timestamp & Delivery Footer -->
                                <Label Text="{Binding StatusText}"
                                       TextColor="#8E8E93"
                                       FontSize="10"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Row 2: Active Photo Reply Banner (BR-302) -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasReplyPost}"
                BackgroundColor="#1C1C1E"
                Stroke="#2C2C2E"
                StrokeThickness="1"
                Margin="14,4,14,0"
                Padding="10,8"
                StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="0">
                    <Image Source="{Binding ReplyingToPost.MediaLocalPath}" Aspect="AspectFill" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Replying to photo" TextColor="#FFB800" FontFamily="OpenSansSemibold" FontSize="12" FontAttributes="Bold" />
                    <Label Text="{Binding ReplyingToPost.Caption}" TextColor="#8E8E93" FontSize="12" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Border Grid.Column="2"
                        WidthRequest="32"
                        HeightRequest="32"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="#2C2C2E"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearReplyPostCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="✕" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Row 3: Quick Emoji Reactions Bar (BR-302) -->
        <HorizontalStackLayout Grid.Row="3" Spacing="10" HorizontalOptions="Center" Margin="14,6">
            <Border BackgroundColor="#1C1C1E" StrokeShape="RoundRectangle 18" StrokeThickness="0" HeightRequest="36" WidthRequest="50" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendReactionCommand}" CommandParameter="❤️" />
                </Border.GestureRecognizers>
                <Label Text="❤️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border BackgroundColor="#1C1C1E" StrokeShape="RoundRectangle 18" StrokeThickness="0" HeightRequest="36" WidthRequest="50" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendReactionCommand}" CommandParameter="🔥" />
                </Border.GestureRecognizers>
                <Label Text="🔥" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border BackgroundColor="#1C1C1E" StrokeShape="RoundRectangle 18" StrokeThickness="0" HeightRequest="36" WidthRequest="50" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendReactionCommand}" CommandParameter="😂" />
                </Border.GestureRecognizers>
                <Label Text="😂" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border BackgroundColor="#1C1C1E" StrokeShape="RoundRectangle 18" StrokeThickness="0" HeightRequest="36" WidthRequest="50" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendReactionCommand}" CommandParameter="😮" />
                </Border.GestureRecognizers>
                <Label Text="😮" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border BackgroundColor="#1C1C1E" StrokeShape="RoundRectangle 18" StrokeThickness="0" HeightRequest="36" WidthRequest="50" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendReactionCommand}" CommandParameter="👏" />
                </Border.GestureRecognizers>
                <Label Text="👏" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>

        <!-- Row 4: Incognito Message Input Bar (BR-301) -->
        <Grid Grid.Row="4" ColumnDefinitions="*, Auto" ColumnSpacing="10" Padding="14,8,14,18" BackgroundColor="#000000">
            <Border Grid.Column="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 23"
                    BackgroundColor="#1C1C1E"
                    Padding="16,2"
                    HeightRequest="46">
                <controls:IncognitoEntry Text="{Binding MessageText}"
                                         Placeholder="Send a message..."
                                         PlaceholderColor="#8E8E93"
                                         TextColor="#FFFFFF"
                                         BackgroundColor="Transparent"
                                         FontFamily="OpenSansRegular"
                                         FontSize="15"
                                         HorizontalOptions="Fill"
                                         ReturnType="Send"
                                         ReturnCommand="{Binding SendMessageCommand}"
                                         VerticalOptions="Center" />
            </Border>

            <Border Grid.Column="1"
                    WidthRequest="46"
                    HeightRequest="46"
                    StrokeShape="RoundRectangle 23"
                    StrokeThickness="0"
                    BackgroundColor="#FFB800"
                    Padding="0"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                </Border.GestureRecognizers>
                <Path Fill="#000000"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Data="M2,18 L19,10 L2,2 L2,8 L14,10 L2,12 L2,18 Z" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>
