<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:Pocket.Client.PageModels"
             xmlns:models="clr-namespace:Pocket.Client.Models"
             xmlns:controls="clr-namespace:Pocket.Client.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Pocket.Client.Pages.DmPage"
             x:Name="thisDmPage"
             x:DataType="pm:DmPageModel"
             Title="Direct Messages"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="IsStringNotNullOrWhiteSpaceConverter" />
    </ContentPage.Resources>

    <Grid x:Name="DmRootGrid" RowDefinitions="*, Auto, Auto, Auto" BackgroundColor="#000000">

        <!-- Row 0 (Base Layer): Messages CollectionView (scrolls underneath the top gradient header) -->
        <CollectionView Grid.Row="0"
                        x:Name="MessagesCollectionView"
                        ItemsSource="{Binding Messages}"
                        BackgroundColor="Transparent"
                        VerticalScrollBarVisibility="Never"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.Header>
                <BoxView HeightRequest="68" BackgroundColor="Transparent" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" BackgroundColor="Transparent" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="32">
                    <Label Text="Send a message"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Messages and reactions are end-to-end encrypted."
                           TextColor="#8E8E93"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DirectMessage">
                    <VerticalStackLayout Padding="12,3" Spacing="8">

                        <!-- Large Rounded Photo Card when message replies to a Feed Photo -->
                        <Border IsVisible="{Binding ShowMediaCard}"
                                HeightRequest="368"
                                Margin="0,8,0,2"
                                StrokeShape="RoundRectangle 34"
                                StrokeThickness="0"
                                BackgroundColor="#141414"
                                Padding="0"
                                HorizontalOptions="Fill">
                            <Grid>
                                <Image Source="{Binding ReferencedPostPath}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />

                                <!-- Top-Left Photo Author & Relative Time Pill ("You 1d") -->
                                <Border BackgroundColor="#78000000"
                                        StrokeShape="RoundRectangle 19"
                                        StrokeThickness="0"
                                        Padding="7,5,13,5"
                                        Margin="14,14,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">
                                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                        <Border WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeShape="RoundRectangle 13"
                                                StrokeThickness="0"
                                                BackgroundColor="#2C2C2E"
                                                Padding="0"
                                                VerticalOptions="Center">
                                            <Grid>
                                                <Path Fill="#8E8E93"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Scale="0.65"
                                                      Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                                <Image Source="{Binding ReferencedPostAuthorAvatarUrl}"
                                                       IsVisible="{Binding ReferencedPostAuthorAvatarUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                       Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding ReferencedPostAuthorLabel}"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding ReferencedPostTimeText}"
                                               TextColor="#C7C7CC"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Incoming Message Row (Left-aligned: Friend Avatar + Dark Bubble) -->
                        <Grid IsVisible="{Binding IsIncoming}"
                              ColumnDefinitions="Auto, *"
                              ColumnSpacing="10"
                              HorizontalOptions="Start">
                            <Border Grid.Column="0"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="#262629"
                                    Padding="0"
                                    VerticalOptions="End"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <Path Fill="#8E8E93"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Scale="0.75"
                                          Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                    <Image Source="{Binding SenderAvatarUrl}"
                                           IsVisible="{Binding SenderAvatarUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                           Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1"
                                  HorizontalOptions="Start"
                                  HandlerChanged="OnMessageBubbleHandlerChanged">
                                <!-- Normal Text Bubble (when not emoji-only) -->
                                <Border IsVisible="{Binding IsEmojiOnly, Converter={StaticResource InvertedBoolConverter}}"
                                        BackgroundColor="#262629"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="16,10"
                                        MaximumWidthRequest="280"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding DisplayText}"
                                           TextColor="#FFFFFF"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           LineBreakMode="WordWrap" />
                                </Border>

                                <!-- Emoji-Only Message (No background, large emoji) -->
                                <Label IsVisible="{Binding IsEmojiOnly}"
                                       Text="{Binding DisplayText}"
                                       FontSize="34"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center"
                                       Margin="4,2,0,2" />

                                <!-- Optional Corner Reaction Badge -->
                                <Border IsVisible="{Binding HasReactionAndText}"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="0"
                                        BackgroundColor="#262629"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,-12,-10,0">
                                    <Label Text="{Binding ReactionEmoji}"
                                           FontSize="15"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Outgoing Message Row (Right-aligned: Light Grey/White Bubble with Dark Text) -->
                        <HorizontalStackLayout IsVisible="{Binding IsOutgoing}"
                                               HorizontalOptions="End"
                                               Spacing="10"
                                               VerticalOptions="Center">

                            <!-- Failed Message Action Icons (Retry & Trash) -->
                            <HorizontalStackLayout IsVisible="{Binding IsFailed}"
                                                   Spacing="6"
                                                   VerticalOptions="Center">
                                <!-- Retry Button -->
                                <Grid WidthRequest="34"
                                      HeightRequest="34"
                                      BackgroundColor="Transparent"
                                      VerticalOptions="Center">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference thisDmPage}, Path=BindingContext.RetryMessageCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Path WidthRequest="22"
                                          HeightRequest="22"
                                          Stroke="#FF453A"
                                          StrokeThickness="2.2"
                                          StrokeLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          InputTransparent="True"
                                          Data="M18.36,8 A7,7 0 1,0 19,12 M18.5,3.5 L18.5,8.5 L13.5,8.5" />
                                </Grid>

                                <!-- Delete (Trash) Button -->
                                <Grid WidthRequest="34"
                                      HeightRequest="34"
                                      BackgroundColor="Transparent"
                                      VerticalOptions="Center">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference thisDmPage}, Path=BindingContext.DeleteFailedMessageCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Path WidthRequest="22"
                                          HeightRequest="22"
                                          Fill="#FF453A"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          InputTransparent="True"
                                          Data="M8.5,2 C7.95,2 7.5,2.45 7.5,3 L7.5,4 L4,4 C3.45,4 3,4.45 3,5 C3,5.55 3.45,6 4,6 L18,6 C18.55,6 19,5.55 19,5 C19,4.45 18.55,4 18,4 L14.5,4 L14.5,3 C14.5,2.45 14.05,2 13.5,2 L8.5,2 Z M5,7.5 L5.7,18.2 C5.78,19.2 6.6,20 7.6,20 L14.4,20 C15.4,20 16.22,19.2 16.3,18.2 L17,7.5 L5,7.5 Z M9.2,10 C9.75,10 10.2,10.45 10.2,11 L10.2,16.5 C10.2,17.05 9.75,17.5 9.2,17.5 C8.65,17.5 8.2,17.05 8.2,16.5 L8.2,11 C8.2,10.45 8.65,10 9.2,10 Z M12.8,10 C13.35,10 13.8,10.45 13.8,11 L13.8,16.5 C13.8,17.05 13.35,17.5 12.8,17.5 C12.25,17.5 11.8,17.05 11.8,16.5 L11.8,11 C11.8,10.45 12.25,10 12.8,10 Z" />
                                </Grid>
                            </HorizontalStackLayout>

                            <Grid HorizontalOptions="End"
                                  VerticalOptions="Center"
                                  HandlerChanged="OnMessageBubbleHandlerChanged">
                                <!-- Normal Text Bubble (when not emoji-only) -->
                                <Border IsVisible="{Binding IsEmojiOnly, Converter={StaticResource InvertedBoolConverter}}"
                                        BackgroundColor="#EBEBF0"
                                        Stroke="{Binding OutgoingBubbleStrokeColor}"
                                        StrokeThickness="{Binding OutgoingBubbleStrokeThickness}"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="16,10"
                                        MaximumWidthRequest="260"
                                        HorizontalOptions="End">
                                    <Label Text="{Binding DisplayText}"
                                           TextColor="#0A0A0A"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           LineBreakMode="WordWrap" />
                                </Border>

                                <!-- Emoji-Only Message (No background when normal; 2px red border when failed) -->
                                <Border IsVisible="{Binding IsEmojiOnly}"
                                        BackgroundColor="Transparent"
                                        Stroke="{Binding OutgoingBubbleStrokeColor}"
                                        StrokeThickness="{Binding OutgoingBubbleStrokeThickness}"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="10,4"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding DisplayText}"
                                           FontSize="34"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Optional Top-Left Corner Reaction Badge (e.g. 💋) -->
                                <Border IsVisible="{Binding HasReactionAndText}"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="0"
                                        BackgroundColor="#262629"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="-12,-12,0,0">
                                    <Label Text="{Binding ReactionEmoji}"
                                           FontSize="15"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Row 0 (Top Overlay Layer): Left-aligned Header with Upward-Darkening Gradient -->
        <Grid Grid.Row="0"
              VerticalOptions="Start"
              HorizontalOptions="Fill"
              HeightRequest="88"
              ZIndex="10">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F2000000" Offset="0.0" />
                    <GradientStop Color="#BF000000" Offset="0.48" />
                    <GradientStop Color="#59000000" Offset="0.78" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <HorizontalStackLayout HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Spacing="10"
                                   Margin="12,12,16,0">
                <!-- Back Arrow -->
                <Grid WidthRequest="36"
                      HeightRequest="38"
                      HorizontalOptions="Start"
                      VerticalOptions="Center"
                      BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Grid.GestureRecognizers>
                    <Path Stroke="#FFFFFF"
                          StrokeThickness="2.3"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Data="M16,8 L2,8 M8,2 L2,8 L8,14" />
                </Grid>

                <!-- Friend Display Name (Left-aligned) -->
                <Label Text="{Binding FriendDisplayName}"
                       TextColor="#FFFFFF"
                       FontFamily="OpenSansSemibold"
                       FontSize="19"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Row 1: Active Photo Reply Banner (when replying to a specific post from DM) -->
        <Border x:Name="PhotoReplyBanner"
                Grid.Row="1"
                IsVisible="{Binding HasReplyPost}"
                BackgroundColor="#1C1C1E"
                Stroke="#2C2C2E"
                StrokeThickness="1"
                Margin="12,4,12,0"
                Padding="10,8"
                StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="0">
                    <Image Source="{Binding ReplyingToPost.MediaLocalPath}" Aspect="AspectFill" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Replying to photo" TextColor="{DynamicResource AccentColor}" FontFamily="OpenSansSemibold" FontSize="12" FontAttributes="Bold" />
                    <Label Text="{Binding ReplyingToPost.Caption}" TextColor="#8E8E93" FontSize="12" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Border Grid.Column="2"
                        WidthRequest="32"
                        HeightRequest="32"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="#2C2C2E"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearReplyPostCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="✕" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Bottom "Send message..." Pill with Quick Emojis + Add Emoji Icon -->
        <Border x:Name="BottomInputBar"
                Grid.Row="2"
                Margin="12,6,12,14"
                HeightRequest="54"
                StrokeShape="RoundRectangle 27"
                StrokeThickness="0"
                BackgroundColor="#222225"
                Padding="20,0,16,0"
                HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <controls:IncognitoEntry x:Name="DmMessageEntry"
                                         Grid.Column="0"
                                         Text="{Binding MessageText}"
                                         Placeholder="Send message..."
                                         PlaceholderColor="#8E8E93"
                                         TextColor="#FFFFFF"
                                         BackgroundColor="Transparent"
                                         FontFamily="OpenSansSemibold"
                                         FontSize="16.5"
                                         HorizontalOptions="Fill"
                                         ReturnType="Send"
                                         ReturnCommand="{Binding SendMessageCommand}"
                                         Focused="OnDmMessageEntryFocused"
                                         Unfocused="OnDmMessageEntryUnfocused"
                                         VerticalOptions="Center" />

                <!-- Right (When input is empty): 3 Quick Emojis + Add-Emoji Icon (😊+) -->
                <HorizontalStackLayout Grid.Column="1"
                                       IsVisible="{Binding ShowQuickEmojis}"
                                       Spacing="12"
                                       VerticalOptions="Center">
                    <Label Text="{Binding FirstRecentEmoji}" FontSize="23" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendFirstRecentEmojiCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding SecondRecentEmoji}" FontSize="23" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendSecondRecentEmojiCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding ThirdRecentEmoji}" FontSize="23" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendThirdRecentEmojiCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Add-Emoji Picker Icon (😊+ - Opens Custom Emoji Picker Bottom Sheet) -->
                    <Grid WidthRequest="30"
                          HeightRequest="30"
                          VerticalOptions="Center"
                          Margin="2,0,0,0"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenEmojiPickerCommand}" />
                        </Grid.GestureRecognizers>
                        <Path Stroke="#8E8E93"
                              StrokeThickness="2.2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              InputTransparent="True"
                              Data="M11.5,4 A8.5,8.5 0 1,0 20,12.5 M8.2,14.2 Q11.5,17.2 14.8,14.2 M16,5.5 L22,5.5 M19,2.5 L19,8.5" />
                        <Ellipse WidthRequest="2.5"
                                 HeightRequest="2.5"
                                 Fill="#8E8E93"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Start"
                                 InputTransparent="True"
                                 Margin="7.5,9.5,0,0" />
                        <Ellipse WidthRequest="2.5"
                                 HeightRequest="2.5"
                                 Fill="#8E8E93"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Start"
                                 InputTransparent="True"
                                 Margin="13,9.5,0,0" />
                    </Grid>
                </HorizontalStackLayout>

                <!-- Right (When user has typed text): Send Button -->
                <Border Grid.Column="1"
                        IsVisible="{Binding HasMessageText}"
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeShape="RoundRectangle 17"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource AccentColor}"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                    </Border.GestureRecognizers>
                    <Path WidthRequest="16"
                          HeightRequest="16"
                          Stroke="#222225"
                          StrokeThickness="2.4"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Data="M8,13 L8,3.5 M3.5,8 L8,3.5 L12.5,8" />
                </Border>
            </Grid>
        </Border>

        <!-- Row 3: Dynamic spacer for Android soft keyboard (IME) -->
        <BoxView x:Name="KeyboardSpacerBox"
                 Grid.Row="3"
                 HeightRequest="0"
                 BackgroundColor="Transparent"
                 Color="Transparent"
                 InputTransparent="True" />

        <!-- ============================================================== -->
        <!-- CUSTOM EMOJI PICKER BOTTOM SHEET OVERLAY                       -->
        <!-- ============================================================== -->
        <Grid x:Name="EmojiPickerOverlayGrid"
              Grid.Row="0"
              Grid.RowSpan="4"
              ZIndex="20"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <!-- Semi-transparent backdrop to dismiss emoji picker on tap outside -->
            <BoxView x:Name="EmojiPickerBackdrop"
                     BackgroundColor="#66000000"
                     Color="#66000000"
                     Opacity="0"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEmojiPickerBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Rounded Top Bottom Sheet Card -->
            <Border x:Name="EmojiPickerSheetCard"
                    VerticalOptions="End"
                    HorizontalOptions="Fill"
                    HeightRequest="476"
                    TranslationY="500"
                    BackgroundColor="#202022"
                    StrokeShape="RoundRectangle 30,30,0,0"
                    StrokeThickness="0"
                    Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, *">

                    <!-- Row 0: Search Bar Header (Also draggable downward to dismiss) -->
                    <Grid Grid.Row="0"
                          BackgroundColor="Transparent"
                          Padding="18,18,18,8">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnEmojiPickerSheetPanUpdated" />
                        </Grid.GestureRecognizers>

                        <Border HeightRequest="44"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                BackgroundColor="#323235"
                                Padding="18,0,12,0"
                                HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <controls:IncognitoEntry x:Name="EmojiSearchEntry"
                                                         Grid.Column="0"
                                                         Text="{Binding EmojiSearchText}"
                                                         Placeholder="Search"
                                                         PlaceholderColor="#8E8E93"
                                                         TextColor="#FFFFFF"
                                                         FontFamily="OpenSansRegular"
                                                         FontSize="17"
                                                         BackgroundColor="Transparent"
                                                         ReturnType="Search"
                                                         Focused="OnEmojiSearchEntryFocused"
                                                         Unfocused="OnEmojiSearchEntryUnfocused"
                                                         Completed="OnEmojiSearchEntryCompleted"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="Fill" />

                                <Grid Grid.Column="1"
                                      IsVisible="{Binding HasEmojiSearchText}"
                                      WidthRequest="28"
                                      HeightRequest="28"
                                      BackgroundColor="Transparent"
                                      VerticalOptions="Center">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearEmojiSearchCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border WidthRequest="20"
                                            HeightRequest="20"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            BackgroundColor="#525256"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Path WidthRequest="8"
                                              HeightRequest="8"
                                              Stroke="#202022"
                                              StrokeThickness="2"
                                              StrokeLineCap="Round"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M1,1 L7,7 M7,1 L1,7" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 1: Scrollable Categorized 6-Column Emoji List + Floating Bottom Category Bar -->
                    <Grid Grid.Row="1">
                        <CollectionView x:Name="EmojiPickerCollectionView"
                                        ItemsSource="{Binding EmojiPickerRows}"
                                        BackgroundColor="Transparent"
                                        SelectionMode="None"
                                        VerticalScrollBarVisibility="Default"
                                        Scrolled="OnEmojiPickerScrolled">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:EmojiListRow">
                                    <Grid>
                                        <!-- Category Section Header Row ("Smileys & Emotion", etc.) -->
                                        <Label IsVisible="{Binding IsHeader}"
                                               Text="{Binding HeaderTitle}"
                                               TextColor="#9A9AA0"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               Margin="20,10,20,8"
                                               VerticalOptions="Center" />

                                        <!-- 6-Column Emoji Row -->
                                        <Grid IsVisible="{Binding IsEmojiRow}"
                                              ColumnDefinitions="*, *, *, *, *, *"
                                              Padding="10,2"
                                              HeightRequest="56">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Emoji0}"
                                                   IsVisible="{Binding HasEmoji0}"
                                                   FontSize="33"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference thisDmPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
                                                                          CommandParameter="{Binding Emoji0}" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Emoji1}"
                                                   IsVisible="{Binding HasEmoji1}"
                                                   FontSize="33"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference thisDmPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
