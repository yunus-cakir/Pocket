                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M10,1 C4.48,1 0,4.8 0,9.5 C0,11.6 0.9,13.5 2.4,15 L1,18.5 L5.2,16.9 C6.7,17.6 8.3,18 10,18 C15.52,18 20,14.2 20,9.5 C20,4.8 15.52,1 10,1 Z" />
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- Right: Share Button (Visible in Feed View - Image 4, Unimplemented feature noted) -->
                    <Border Grid.Column="2"
                            IsVisible="{Binding IsViewingFeed}"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 24"
                            StrokeThickness="0"
                            BackgroundColor="#1C1C1E"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Path Stroke="#FFFFFF"
                              StrokeThickness="2"
                              Fill="#FFFFFF"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M14,3.5 C15,3.5 15.8,2.7 15.8,1.7 C15.8,0.7 15,0 14,0 C13,0 12.2,0.7 12.2,1.7 C12.2,2.7 13,3.5 14,3.5 Z M2.5,10.2 C3.5,10.2 4.3,9.4 4.3,8.4 C4.3,7.4 3.5,6.7 2.5,6.7 C1.5,6.7 0.7,7.4 0.7,8.4 C0.7,9.4 1.5,10.2 2.5,10.2 Z M14,17 C15,17 15.8,16.2 15.8,15.2 C15.8,14.2 15,13.5 14,13.5 C13,13.5 12.2,14.2 12.2,15.2 C12.2,16.2 13,17 14,17 Z M4.1,7.5 L12.4,2.6 M4.1,9.3 L12.4,14.2" />
                    </Border>

                    </Grid>
                </VerticalStackLayout>

                <!-- ============================================================== -->
                <!-- ACTIVITY BOTTOM SHEET OVERLAY (Reactions on Own Post)          -->
                <!-- ============================================================== -->
                <Grid IsVisible="{Binding IsActivitySheetOpen}"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <!-- Semi-transparent backdrop to dismiss sheet on tap outside -->
                    <BoxView BackgroundColor="#77000000"
                             Color="#77000000"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseActivitySheetCommand}" />
                        </BoxView.GestureRecognizers>
                    </BoxView>

                    <!-- Rounded Top Bottom Sheet Card -->
                    <Border VerticalOptions="End"
                            HorizontalOptions="Fill"
                            HeightRequest="380"
                            BackgroundColor="#1C1C1E"
                            StrokeShape="RoundRectangle 32,32,0,0"
                            StrokeThickness="0"
                            Padding="20,12,20,24">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto, Auto, *">
                            <!-- Top Drag Handle Pill -->
                            <BoxView Grid.Row="0"
                                     WidthRequest="38"
                                     HeightRequest="5"
                                     CornerRadius="2.5"
                                     Color="#5A5A5E"
                                     BackgroundColor="#5A5A5E"
                                     HorizontalOptions="Center"
                                     Margin="0,2,0,16">
                                <BoxView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseActivitySheetCommand}" />
                                </BoxView.GestureRecognizers>
                            </BoxView>

                            <!-- Sheet Title: "Activity" -->
                            <Label Grid.Row="1"
                                   Text="Activity"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,20" />

                            <!-- Friends & Their Reactions List -->
                            <CollectionView Grid.Row="2"
                                            ItemsSource="{Binding CurrentFeedPost.ActivityItems}"
                                            BackgroundColor="Transparent"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PostActivityItem">
                                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,8">
                                            <Border Grid.Column="0"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeShape="RoundRectangle 22"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#2C2C2E"
                                                    Padding="0"
                                                    VerticalOptions="Center">
                                                <Grid>
                                                    <Path Fill="#8E8E93"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center"
                                                          Scale="0.95"
                                                          Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                                    <Image Source="{Binding FriendAvatarUrl}" Aspect="AspectFill" />
                                                </Grid>
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Text="{Binding FriendName}"
                                                   TextColor="#FFFFFF"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="17"
                                                   FontAttributes="Bold"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"
                                                   Margin="14,0,12,0" />

                                            <Label Grid.Column="2"
                                                   Text="{Binding EmojisText}"
                                                   FontSize="26"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <!-- ================================================================== -->
            <!-- PANEL 2: CHAT LIST PAGE (Reference Image 2)                        -->
            <!-- ================================================================== -->
            <Grid x:Name="ChatPanel" Grid.Column="2" BackgroundColor="#000000" RowDefinitions="Auto, *, Auto">

                <!-- Row 0: Top Header ("Chat" centered + Top-Right Profile Avatar) -->
                <Grid Grid.Row="0" ColumnDefinitions="42, *, 42" Margin="16,14,16,12">
                    <BoxView Grid.Column="0" BackgroundColor="Transparent" Color="Transparent" />

                    <Label Grid.Column="1"
                           Text="Chat"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Border Grid.Column="2"
                            WidthRequest="42"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 21"
                            StrokeThickness="0"
                            BackgroundColor="#1C1C1E"
                            Padding="0"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SnapToProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Path Fill="#8E8E93"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Scale="0.95"
                                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                            <Image Source="{Binding ShellModel.CurrentUser.ProfilePictureUrl}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 1: Chat / Friends List (Reference Image 2) -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding ShellModel.Friends}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="32">
                            <Label Text="No chats yet"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center" />
                            <Label Text="Tap the yellow button below to find and add friends."
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="#8E8E93"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Friend">
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,10" ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
                                </Grid.GestureRecognizers>

                                <!-- Avatar with dark ring -->
                                <Border Grid.Column="0"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        StrokeShape="RoundRectangle 30"
                                        Stroke="#262626"
                                        StrokeThickness="2"
                                        BackgroundColor="#000000"
                                        Padding="3"
                                        VerticalOptions="Center">
                                    <Border WidthRequest="50"
                                            HeightRequest="50"
                                            StrokeShape="RoundRectangle 25"
                                            StrokeThickness="0"
                                            BackgroundColor="#1C1C1E"
                                            Padding="0">
                                        <Grid>
                                            <Path Fill="#8E8E93"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Scale="1.05"
                                                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                            <Image Source="{Binding ProfilePictureUrl}" Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- Friend Name & Last Message -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding DisplayName}"
                                           TextColor="#FFFFFF"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="17"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding LastMessagePreview}"
                                           TextColor="#8E8E93"
                                           FontFamily="OpenSansRegular"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Relative Time ("1h") -->
                                <Label Grid.Column="2"
                                       Text="{Binding LastMessageTimeText}"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       VerticalOptions="Start"
                                       Margin="0,8,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Row 2: Bottom Navigation Bar + Floating Gold Compose Button (Reference Image 2) -->
                <Grid Grid.Row="2" ColumnDefinitions="56, *, 56" Margin="18,0,18,18" VerticalOptions="End">
                    <BoxView Grid.Column="0" BackgroundColor="Transparent" Color="Transparent" />

                    <!-- Center Floating 3-Tab Pill (Chat Tab Active) -->
                    <Border Grid.Column="1"
                            WidthRequest="190"
                            HeightRequest="56"
                            StrokeShape="RoundRectangle 28"
                            StrokeThickness="0"
                            BackgroundColor="#1C1C1E"
                            Padding="5"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Grid ColumnDefinitions="*, *, *">

                            <!-- Tab 0: Calendar / Rollcall Icon (Unimplemented feature - noted) -->
                            <Grid Grid.Column="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Border WidthRequest="22"
                                        HeightRequest="20"
                                        StrokeShape="RoundRectangle 5"
                                        StrokeThickness="0"
                                        BackgroundColor="#8E8E93"
                                        Padding="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Grid RowDefinitions="6, *" Padding="3,2">
                                        <BoxView Grid.Row="0" HeightRequest="2" BackgroundColor="#1C1C1E" Color="#1C1C1E" VerticalOptions="End" />
                                        <Grid Grid.Row="1" RowDefinitions="*, *" ColumnDefinitions="*, *, *" Margin="1,2,1,1">
                                            <BoxView Grid.Row="0" Grid.Column="0" WidthRequest="2.5" HeightRequest="2.5" CornerRadius="1.2" Color="#1C1C1E" BackgroundColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <BoxView Grid.Row="0" Grid.Column="1" WidthRequest="2.5" HeightRequest="2.5" CornerRadius="1.2" Color="#1C1C1E" BackgroundColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <BoxView Grid.Row="0" Grid.Column="2" WidthRequest="2.5" HeightRequest="2.5" CornerRadius="1.2" Color="#1C1C1E" BackgroundColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <BoxView Grid.Row="1" Grid.Column="0" WidthRequest="2.5" HeightRequest="2.5" CornerRadius="1.2" Color="#1C1C1E" BackgroundColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <BoxView Grid.Row="1" Grid.Column="1" WidthRequest="2.5" HeightRequest="2.5" CornerRadius="1.2" Color="#1C1C1E" BackgroundColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <BoxView Grid.Row="1" Grid.Column="2" WidthRequest="2.5" HeightRequest="2.5" CornerRadius="1.2" Color="#1C1C1E" BackgroundColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Tab 1: Home Icon (Active - Snaps to Camera) -->
                            <Grid Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SnapToCameraCommand}" />
                                </Grid.GestureRecognizers>
                                <Path Fill="#8E8E93"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M10,1.5 L1,8.5 L1,18.5 C1,19.3 1.7,20 2.5,20 L7.5,20 L7.5,13.5 C7.5,12.7 8.2,12 9,12 L11,12 C11.8,12 12.5,12.7 12.5,13.5 L12.5,20 L17.5,20 C18.3,20 19,19.3 19,18.5 L19,8.5 L10,1.5 Z" />
                            </Grid>

                            <!-- Tab 2: Active Chat Pill -->
                            <Border Grid.Column="2"
                                    BackgroundColor="#3A3A3C"
                                    StrokeShape="RoundRectangle 23"
                                    StrokeThickness="0"
                                    Padding="0"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">
                                <Path Fill="#FFFFFF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M10,1 C4.48,1 0,4.8 0,9.5 C0,11.6 0.9,13.5 2.4,15 L1,18.5 L5.2,16.9 C6.7,17.6 8.3,18 10,18 C15.52,18 20,14.2 20,9.5 C20,4.8 15.52,1 10,1 Z" />
                            </Border>

                        </Grid>
                    </Border>

                    <!-- Right: Floating Gold Circle Pencil Button (Active - Opens Add Friend / New Chat) -->
                    <Border Grid.Column="2"
                            WidthRequest="56"
                            HeightRequest="56"
                            StrokeShape="RoundRectangle 28"
                            StrokeThickness="0"
                            BackgroundColor="#FFB800"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShellModel.AddFriendCommand}" />
                        </Border.GestureRecognizers>
                        <Path Fill="#000000"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M2,16.2 L2,20 L5.8,20 L17,8.8 L13.2,5 L2,16.2 Z M19.7,6.1 C20.1,5.7 20.1,5.1 19.7,4.7 L17.3,2.3 C16.9,1.9 16.3,1.9 15.9,2.3 L14.1,4.1 L17.9,7.9 L19.7,6.1 Z" />
                    </Border>
                </Grid>

            </Grid>

        </Grid>
    </controls:HorizontalSwipeView>
</ContentPage>
