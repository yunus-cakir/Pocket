<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:Pocket.Client.PageModels"
             xmlns:models="clr-namespace:Pocket.Client.Models"
             xmlns:controls="clr-namespace:Pocket.Client.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Pocket.Client.Pages.CameraPage"
             x:DataType="pm:CameraPageModel"
             x:Name="thisPage"
             Title="Pocket"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="IsStringNotNullOrWhiteSpaceConverter" />
    </ContentPage.Resources>

    <controls:HorizontalSwipeView x:Name="SwipeContainer">
        <!-- Container translated horizontally across 3 panels: 0=Profile, 1=Camera/Feed, 2=Chat -->
        <Grid x:Name="PanContainer" ColumnDefinitions="Auto, Auto, Auto" HorizontalOptions="Start" BackgroundColor="#000000">

            <!-- ================================================================== -->
            <!-- PANEL 0: PROFILE & SETTINGS PAGE (Reference Image 1)               -->
            <!-- ================================================================== -->
            <Grid x:Name="ProfilePanel" Grid.Column="0" BackgroundColor="#000000">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,32">

                        <!-- Top Left Back Arrow -->
                        <Grid Padding="16,14,16,0">
                            <Grid WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SnapToCameraCommand}" />
                                </Grid.GestureRecognizers>
                                <Path Stroke="#A1A1AA"
                                      StrokeThickness="2.2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M15,6 L3,6 M8,1 L3,6 L8,11" />
                            </Grid>
                        </Grid>

                        <!-- Large Profile Avatar with Locket Gold Ring -->
                        <Border WidthRequest="116"
                                HeightRequest="116"
                                StrokeShape="RoundRectangle 58"
                                Stroke="#FFB800"
                                StrokeThickness="4"
                                BackgroundColor="#000000"
                                Padding="5"
                                HorizontalOptions="Center"
                                Margin="0,2,0,0">
                            <Border WidthRequest="98"
                                    HeightRequest="98"
                                    StrokeShape="RoundRectangle 49"
                                    StrokeThickness="0"
                                    BackgroundColor="#1C1C1E"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid>
                                    <!-- Default Avatar Silhouette when no image is set -->
                                    <Path Fill="#636366"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Scale="1.6"
                                          Data="M12,12 C14.76,12 17,9.76 17,7 C17,4.24 14.76,2 12,2 C9.24,2 7,4.24 7,7 C7,9.76 9.24,12 12,12 Z M12,14.5 C8.67,14.5 2,16.17 2,19.5 L2,22 L22,22 L22,19.5 C22,16.17 15.33,14.5 12,14.5 Z" />
                                    <Image Source="{Binding ShellModel.CurrentUser.ProfilePictureUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>
                        </Border>

                        <!-- User Display Name -->
                        <Label Text="{Binding ShellModel.CurrentUser.DisplayName}"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,12,0,2" />

                        <!-- Edit Photo Button (Unimplemented feature - noted) -->
                        <Label Text="Edit Photo"
                               TextColor="#EAB308"
                               FontFamily="OpenSansSemibold"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,2,0,0" />

                        <!-- Rollcall & Invite Combined Card -->
                        <Border BackgroundColor="#1C1C1E"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                Padding="0"
                                Margin="16,22,16,0">
                            <VerticalStackLayout Spacing="0">

                                <!-- Row 1: Rollcall (Unimplemented feature - noted) -->
                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,16">
                                    <!-- Tilted Photo Thumbnail -->
                                    <Grid Grid.Column="0" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                                        <Border WidthRequest="36"
                                                HeightRequest="44"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="#3A3A3C"
                                                StrokeThickness="1"
                                                BackgroundColor="#2C2C2E"
                                                Rotation="-8"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Grid BackgroundColor="#262626">
                                                <Path Fill="#8E8E93"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Scale="0.8"
                                                      Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="12,0,0,0">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <!-- Megaphone Icon -->
                                            <Path Fill="#FFFFFF"
                                                  VerticalOptions="Center"
                                                  Data="M14,2 L5,6.5 L2,6.5 C1.17,6.5 0.5,7.17 0.5,8 L0.5,10 C0.5,10.83 1.17,11.5 2,11.5 L3.2,11.5 L4.6,15.5 L6.6,15.5 L5.3,11.5 L14,15.5 L14,2 Z M16.5,6.5 L18.5,5.5 M17,9 L19.5,9 M16.5,11.5 L18.5,12.5"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="1.2" />
                                            <Label Text="Rollcall"
                                                   TextColor="#FFFFFF"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="A friend shared!"
                                               TextColor="#8E8E93"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            BackgroundColor="#2C2C2E"
                                            StrokeShape="RoundRectangle 18"
                                            StrokeThickness="0"
                                            Padding="16,8"
                                            VerticalOptions="Center">
                                        <Label Text="OPEN"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <!-- Divider -->
                                <BoxView HeightRequest="1" BackgroundColor="#2C2C2E" Color="#2C2C2E" />

                                <!-- Row 2: Invite friends to Locket! -->
                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,16">
                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeShape="RoundRectangle 23"
                                            Stroke="#FFB800"
                                            StrokeThickness="2"
                                            BackgroundColor="#000000"
                                            Padding="2"
                                            VerticalOptions="Center">
                                        <Border WidthRequest="38"
                                                HeightRequest="38"
                                                StrokeShape="RoundRectangle 19"
                                                StrokeThickness="0"
                                                BackgroundColor="#2C2C2E"
                                                Padding="0">
                                            <Grid>
                                                <Path Fill="#8E8E93"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Scale="0.9"
                                                      Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                                <Image Source="{Binding ShellModel.CurrentUser.ProfilePictureUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="12,0,0,0">
                                        <Label Text="Invite friends to Locket!"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding ShellModel.CurrentUser.Username, StringFormat='locket.com/{0}'}"
                                               TextColor="#8E8E93"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14" />
                                    </VerticalStackLayout>

                                    <!-- Share Icon -->
                                    <Grid Grid.Column="2" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" HorizontalOptions="End">
                                        <Path Stroke="#D1D5DB"
                                              StrokeThickness="2"
                                              Fill="#D1D5DB"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M15,4 C16.1,4 17,3.1 17,2 C17,0.9 16.1,0 15,0 C13.9,0 13,0.9 13,2 C13,3.1 13.9,4 15,4 Z M3,11 C4.1,11 5,10.1 5,9 C5,7.9 4.1,7 3,7 C1.9,7 1,7.9 1,9 C1,10.1 1.9,11 3,11 Z M15,18 C16.1,18 17,17.1 17,16 C17,14.9 16.1,14 15,14 C13.9,14 13,14.9 13,16 C13,17.1 13.9,18 15,18 Z M4.7,8 L13.3,3 M4.7,10 L13.3,15" />
                                    </Grid>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                        <!-- ========================================== -->
                        <!-- Section: Widget Setup                      -->
                        <!-- ========================================== -->
                        <Label Text="Widget Setup"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="19"
                               FontAttributes="Bold"
                               Margin="16,28,16,8" />

                        <!-- Add the widget (Unimplemented feature - noted) -->
                        <Grid ColumnDefinitions="36, *" Padding="16,14">
                            <Border Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="#9CA3AF"
                                    Padding="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Path Stroke="#000000"
                                      StrokeThickness="2.2"
                                      StrokeLineCap="Round"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M6,1 L6,11 M1,6 L11,6" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Add the widget"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>

                        <!-- How to add the widget (Unimplemented feature - noted) -->
                        <Grid ColumnDefinitions="36, *" Padding="16,14">
                            <Border Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeShape="RoundRectangle 11"
                                    StrokeThickness="0"
                                    BackgroundColor="#9CA3AF"
                                    Padding="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="?"
                                       TextColor="#000000"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="How to add the widget"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>

                        <!-- Streak on widget (Toggle switch - UI state only, noted) -->
                        <Grid ColumnDefinitions="36, *, Auto" Padding="16,12">
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M9.5,0 C9.5,0 15,4.2 15,9.5 C15,13.64 11.86,17 8,17 C4.14,17 1,13.64 1,9.5 C1,6.8 2.6,4.2 4.5,2.5 C4.5,2.5 4.2,5.2 6,6.5 C6,4 7.5,1.5 9.5,0 Z M8,14.5 C9.65,14.5 11,13.15 11,11.5 C11,9.8 9.2,8 8,6.8 C6.8,8 5,9.8 5,11.5 C5,13.15 6.35,14.5 8,14.5 Z" />
                            </Grid>
                            <Label Grid.Column="1"
                                   Text="Streak on widget"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                            <!-- Custom Locket Gold Toggle Pill -->
                            <Border Grid.Column="2"
                                    WidthRequest="54"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="#F5B301"
                                    Padding="3"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShellModel.ToggleStreakOnWidgetCommand}" />
                                </Border.GestureRecognizers>
                                <Border WidthRequest="26"
                                        HeightRequest="26"
                                        StrokeShape="RoundRectangle 13"
                                        StrokeThickness="0"
                                        BackgroundColor="#FFFFFF"
                                        Padding="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsStreakOnWidget}" Value="False">
                                            <Setter Property="HorizontalOptions" Value="Start" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsStreakOnWidget}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#3A3A3C" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>

                        <!-- ========================================== -->
                        <!-- Section: General                           -->
                        <!-- ========================================== -->
                        <Label Text="General"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="19"
                               FontAttributes="Bold"
                               Margin="16,24,16,8" />

                        <!-- Notifications (Unimplemented feature - noted) -->
                        <Grid ColumnDefinitions="36, *" Padding="16,14">
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M8,0 C8.83,0 9.5,0.67 9.5,1.5 L9.5,2.2 C12.1,2.85 14,5.2 14,8 L14,12.5 L16,14.5 L16,15.5 L0,15.5 L0,14.5 L2,12.5 L2,8 C2,5.2 3.9,2.85 6.5,2.2 L6.5,1.5 C6.5,0.67 7.17,0 8,0 Z M6,16.5 L10,16.5 C10,17.6 9.1,18.5 8,18.5 C6.9,18.5 6,17.6 6,16.5 Z" />
                            </Grid>
                            <Label Grid.Column="1"
                                   Text="Notifications"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>

                        <!-- Edit name (Active - bound to EditProfileCommand) -->
                        <Grid ColumnDefinitions="36, *" Padding="16,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShellModel.EditProfileCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="#9CA3AF"
                                    Padding="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Path Fill="#000000"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M8,8 C9.66,8 11,6.66 11,5 C11,3.34 9.66,2 8,2 C6.34,2 5,3.34 5,5 C5,6.66 6.34,8 8,8 Z M8,9.5 C5.67,9.5 1,10.67 1,13 L1,14.5 L15,14.5 L15,13 C15,10.67 10.33,9.5 8,9.5 Z" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="6,0,0,0">
                                <Label Text="Edit name"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding ShellModel.CurrentUser.DisplayName}"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Change email address (Unimplemented feature - noted) -->
                        <Grid ColumnDefinitions="36, *" Padding="16,12">
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M16,2 C17.1,2 18,2.9 18,4 L18,14 C18,15.1 17.1,16 16,16 L2,16 C0.9,16 0,15.1 0,14 L0,4 C0,2.9 0.9,2 2,2 L16,2 Z M16,4 L9,9 L2,4 L2,6 L9,11 L16,6 L16,4 Z" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="6,0,0,0">
                                <Label Text="Change email address"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="yunus.cakir@protonmail.com"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Relay Server Settings Card (Preserves existing network configuration functionality) -->
                        <Border Margin="16,24,16,10"
                                Padding="16"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                BackgroundColor="#1C1C1E">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                        <Border WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="0" BackgroundColor="{Binding ShellModel.ConnectionStatusColor}" Padding="0" VerticalOptions="Center" />
                                        <Label Text="{Binding ShellModel.ConnectionStatusText}" TextColor="{Binding ShellModel.ConnectionStatusColor}" FontFamily="OpenSansSemibold" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding ShellModel.ConnectedAtText}" TextColor="#8E8E93" FontSize="11" VerticalOptions="Center" />
                                </Grid>

                                <Label Text="{Binding ShellModel.ConnectedUrlText, StringFormat='Server: {0}'}" TextColor="#8E8E93" FontSize="12" LineBreakMode="TailTruncation" />

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                    <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#2C2C2E" Padding="12,0" HeightRequest="42">
                                        <Entry Text="{Binding ShellModel.ServerIp}" Placeholder="Server IP (e.g. 192.168.1.35)" PlaceholderColor="#8E8E93" TextColor="White" FontSize="13" VerticalOptions="Center" />
                                    </Border>
                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#FFB800" Padding="16,0" HeightRequest="42" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShellModel.SaveServerIpCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Save" TextColor="#000000" FontFamily="OpenSansSemibold" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- ================================================================== -->
            <!-- PANEL 1: CAMERA & VERTICAL FEED PAGE (Reference Images 3 & 4)      -->
            <!-- ================================================================== -->
            <Grid x:Name="CameraPanel" Grid.Column="1" BackgroundColor="#000000">

                <!-- Vertical Paging CollectionView: Header = Camera (Image 3), Items = History/Feed (Image 4) -->
                <CollectionView x:Name="FeedCollectionView"
                                ItemsSource="{Binding FeedPosts}"
                                BackgroundColor="#000000"
                                Scrolled="OnFeedScrolled"
                                ItemsUpdatingScrollMode="KeepItemsInView">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" SnapPointsType="MandatorySingle" SnapPointsAlignment="Start" />
                    </CollectionView.ItemsLayout>

                    <!-- HEADER: CAMERA VIEW (Reference Image 3) -->
                    <CollectionView.Header>
                        <Grid x:Name="CameraHeaderGrid"
                              HeightRequest="{Binding ViewportHeight}"
                              RowDefinitions="72, Auto, *, 128"
                              BackgroundColor="#000000">

                            <!-- Row 0: Top Spacer for Persistent Top Header -->
                            <BoxView Grid.Row="0" BackgroundColor="Transparent" Color="Transparent" />

                            <!-- Row 1: Camera Viewfinder Rounded Square Card -->
                            <Border Grid.Row="1"
                                    HeightRequest="{Binding CardSize}"
                                    Margin="6,4,6,0"
                                    StrokeShape="RoundRectangle 44"
                                    StrokeThickness="0"
                                    BackgroundColor="#141414"
                                    Padding="0"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Start">
                                <Grid>
                                    <controls:CameraView x:Name="cameraView" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                    <Image Source="{Binding CapturedImagePath}" IsVisible="{Binding IsPreviewing}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />

                                    <!-- Top-Left Flash Button (Unimplemented feature - noted) -->
                                    <Border WidthRequest="38"
                                            HeightRequest="38"
                                            StrokeShape="RoundRectangle 19"
                                            StrokeThickness="0"
                                            BackgroundColor="#4D000000"
                                            Padding="0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="18,18,0,0">
                                        <Path Fill="#FFFFFF"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M9,0 L1,10 L7,10 L5,18 L14,7.5 L8,7.5 L9,0 Z" />
                                    </Border>

                                    <!-- Caption Entry Overlay when Previewing Captured Photo -->
                                    <Border IsVisible="{Binding IsPreviewing}"
                                            BackgroundColor="#99000000"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            Padding="16,4"
                                            Margin="22,0,22,18"
                                            HeightRequest="44"
                                            VerticalOptions="End">
                                        <Entry Text="{Binding Caption}"
                                               Placeholder="Add a message..."
                                               PlaceholderColor="#D1D5DB"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               HorizontalTextAlignment="Center"
                                               BackgroundColor="Transparent"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Row 2: Shutter Controls -->
                            <Grid Grid.Row="2" Padding="0,8,0,6">

                                <!-- Shutter Row (Live Camera Mode - Image 3) -->
                                <Grid IsVisible="{Binding IsPreviewing, Converter={StaticResource InvertedBoolConverter}}"
                                      ColumnDefinitions="*, Auto, *"
                                      VerticalOptions="Center"
                                      Margin="24,0">

                                    <!-- Left: Stacked Photo Gallery Button (Unimplemented feature - noted) -->
                                    <Grid Grid.Column="0" WidthRequest="54" HeightRequest="54" HorizontalOptions="Center" VerticalOptions="Center">
                                        <!-- Tilted Back Card -->
                                        <Border WidthRequest="38"
                                                HeightRequest="42"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="#E5E7EB"
                                                StrokeThickness="1.5"
                                                BackgroundColor="#3A3A3C"
                                                Rotation="-10"
                                                TranslationX="-3"
                                                TranslationY="-2"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        <!-- Front Photo Thumbnail Card -->
                                        <Border WidthRequest="40"
                                                HeightRequest="42"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="#2C2C2E"
                                                StrokeThickness="1.5"
                                                BackgroundColor="#1C1C1E"
                                                Rotation="3"
                                                TranslationX="2"
                                                TranslationY="1"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Grid BackgroundColor="#38BDF8">
                                                <BoxView VerticalOptions="End" HeightRequest="18" BackgroundColor="#22C55E" Color="#22C55E" />
