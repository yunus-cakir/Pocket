<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:Pocket.Client.PageModels"
             xmlns:models="clr-namespace:Pocket.Client.Models"
             xmlns:controls="clr-namespace:Pocket.Client.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Pocket.Client.Pages.CameraPage"
             x:DataType="pm:CameraPageModel"
             x:Name="thisPage"
             Title="Pocket"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="IsStringNotNullOrWhiteSpaceConverter" />
    </ContentPage.Resources>

    <controls:HorizontalSwipeView x:Name="SwipeContainer" IsSwipeEnabled="{Binding IsSwipeAllowed}">
        <Grid BackgroundColor="#000000">
        <!-- Container translated horizontally across 3 panels: 0=Profile, 1=Camera/Feed, 2=Chat -->
        <Grid x:Name="PanContainer" ColumnDefinitions="Auto, Auto, Auto" HorizontalOptions="Start" BackgroundColor="#000000">

            <!-- ================================================================== -->
            <!-- PANEL 0: PROFILE & SETTINGS PAGE (Reference Image 1)               -->
            <!-- ================================================================== -->
            <Grid x:Name="ProfilePanel" Grid.Column="0" BackgroundColor="#000000">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,32">

                        <!-- Top Left Back Arrow -->
                        <Grid Padding="{Binding ProfileTopHeaderPadding}">
                            <Grid WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SnapToCameraCommand}" />
                                </Grid.GestureRecognizers>
                                <Path Stroke="#A1A1AA"
                                      StrokeThickness="2.2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M15,6 L3,6 M8,1 L3,6 L8,11" />
                            </Grid>
                        </Grid>

                        <!-- Large Profile Avatar with Locket Gold Ring -->
                        <Border WidthRequest="116"
                                HeightRequest="116"
                                StrokeShape="RoundRectangle 58"
                                Stroke="{DynamicResource AccentColor}"
                                StrokeThickness="4"
                                BackgroundColor="#000000"
                                Padding="5"
                                HorizontalOptions="Center"
                                Margin="0,2,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShellModel.EditProfilePhotoCommand}" />
                            </Border.GestureRecognizers>
                            <Border WidthRequest="98"
                                    HeightRequest="98"
                                    StrokeShape="RoundRectangle 49"
                                    StrokeThickness="0"
                                    BackgroundColor="#1C1C1E"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid>
                                    <!-- Default Avatar Silhouette when no image is set -->
                                    <Path Fill="#636366"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Scale="1.6"
                                          Data="M12,12 C14.76,12 17,9.76 17,7 C17,4.24 14.76,2 12,2 C9.24,2 7,4.24 7,7 C7,9.76 9.24,12 12,12 Z M12,14.5 C8.67,14.5 2,16.17 2,19.5 L2,22 L22,22 L22,19.5 C22,16.17 15.33,14.5 12,14.5 Z" />
                                    <Image Source="{Binding ShellModel.CurrentUser.ProfilePictureUrl}"
                                           IsVisible="{Binding ShellModel.CurrentUser.ProfilePictureUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                           Aspect="AspectFill" />
                                </Grid>
                            </Border>
                        </Border>

                        <!-- User Display Name -->
                        <Label Text="{Binding ShellModel.CurrentUser.DisplayName}"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,12,0,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShellModel.EditDisplayNameCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Edit Photo Button (Active - bound to EditProfilePhotoCommand) -->
                        <Label Text="Edit Photo"
                               TextColor="{DynamicResource AccentColor}"
                               FontFamily="OpenSansSemibold"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,2,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShellModel.EditProfilePhotoCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Rollcall & Invite Combined Card -->
                        <Border IsVisible="False"
                                BackgroundColor="#1C1C1E"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                Padding="0"
                                Margin="16,22,16,0">
                            <VerticalStackLayout Spacing="0">

                                <!-- Row 1: Rollcall (Unimplemented feature - noted) -->
                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,16">
                                    <!-- Tilted Photo Thumbnail -->
                                    <Grid Grid.Column="0" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                                        <Border WidthRequest="36"
                                                HeightRequest="44"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="#3A3A3C"
                                                StrokeThickness="1"
                                                BackgroundColor="#2C2C2E"
                                                Rotation="-8"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Grid BackgroundColor="#262626">
                                                <Path Fill="#8E8E93"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Scale="0.8"
                                                      Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="12,0,0,0">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <!-- Megaphone Icon -->
                                            <Path Fill="#FFFFFF"
                                                  VerticalOptions="Center"
                                                  Data="M14,2 L5,6.5 L2,6.5 C1.17,6.5 0.5,7.17 0.5,8 L0.5,10 C0.5,10.83 1.17,11.5 2,11.5 L3.2,11.5 L4.6,15.5 L6.6,15.5 L5.3,11.5 L14,15.5 L14,2 Z M16.5,6.5 L18.5,5.5 M17,9 L19.5,9 M16.5,11.5 L18.5,12.5"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="1.2" />
                                            <Label Text="Rollcall"
                                                   TextColor="#FFFFFF"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="A friend shared!"
                                               TextColor="#8E8E93"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            BackgroundColor="#2C2C2E"
                                            StrokeShape="RoundRectangle 18"
                                            StrokeThickness="0"
                                            Padding="16,8"
                                            VerticalOptions="Center">
                                        <Label Text="OPEN"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <!-- Divider -->
                                <BoxView HeightRequest="1" BackgroundColor="#2C2C2E" Color="#2C2C2E" />

                                <!-- Row 2: Invite friends to Locket! -->
                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,16">
                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeShape="RoundRectangle 23"
                                            Stroke="{DynamicResource AccentColor}"
                                            StrokeThickness="2"
                                            BackgroundColor="#000000"
                                            Padding="2"
                                            VerticalOptions="Center">
                                        <Border WidthRequest="38"
                                                HeightRequest="38"
                                                StrokeShape="RoundRectangle 19"
                                                StrokeThickness="0"
                                                BackgroundColor="#2C2C2E"
                                                Padding="0">
                                            <Grid>
                                                <Path Fill="#8E8E93"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Scale="0.9"
                                                      Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                                <Image Source="{Binding ShellModel.CurrentUser.ProfilePictureUrl}"
                                                       IsVisible="{Binding ShellModel.CurrentUser.ProfilePictureUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                       Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="12,0,0,0">
                                        <Label Text="Invite friends to Locket!"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding ShellModel.CurrentUser.Username, StringFormat='locket.com/{0}'}"
                                               TextColor="#8E8E93"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14" />
                                    </VerticalStackLayout>

                                    <!-- Share Icon -->
                                    <Grid Grid.Column="2" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" HorizontalOptions="End">
                                        <Path Stroke="#D1D5DB"
                                              StrokeThickness="2"
                                              Fill="#D1D5DB"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M15,4 C16.1,4 17,3.1 17,2 C17,0.9 16.1,0 15,0 C13.9,0 13,0.9 13,2 C13,3.1 13.9,4 15,4 Z M3,11 C4.1,11 5,10.1 5,9 C5,7.9 4.1,7 3,7 C1.9,7 1,7.9 1,9 C1,10.1 1.9,11 3,11 Z M15,18 C16.1,18 17,17.1 17,16 C17,14.9 16.1,14 15,14 C13.9,14 13,14.9 13,16 C13,17.1 13.9,18 15,18 Z M4.7,8 L13.3,3 M4.7,10 L13.3,15" />
                                    </Grid>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                        <!-- ========================================== -->
                        <!-- Section: General                           -->
                        <!-- ========================================== -->
                        <Label Text="General"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="19"
                               FontAttributes="Bold"
                               Margin="16,28,16,8" />

                        <!-- Notifications -->
                        <Grid ColumnDefinitions="36, *" Padding="16,14" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenNotificationsSheetCommand}" />
                            </Grid.GestureRecognizers>
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M8,0 C8.83,0 9.5,0.67 9.5,1.5 L9.5,2.2 C12.1,2.85 14,5.2 14,8 L14,12.5 L16,14.5 L16,15.5 L0,15.5 L0,14.5 L2,12.5 L2,8 C2,5.2 3.9,2.85 6.5,2.2 L6.5,1.5 C6.5,0.67 7.17,0 8,0 Z M6,16.5 L10,16.5 C10,17.6 9.1,18.5 8,18.5 C6.9,18.5 6,17.6 6,16.5 Z" />
                            </Grid>
                            <Label Grid.Column="1"
                                   Text="Notifications"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>

                        <!-- Add the widget: opens the system "add to home screen" pin dialog -->
                        <Grid ColumnDefinitions="36, *" Padding="16,14" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShellModel.AddWidgetCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="#9CA3AF"
                                    Padding="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Path Stroke="#000000"
                                      StrokeThickness="2.2"
                                      StrokeLineCap="Round"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M6,1 L6,11 M1,6 L11,6" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Add the widget"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>

                        <!-- ========================================== -->
                        <!-- Section: User                              -->
                        <!-- ========================================== -->
                        <Label Text="User"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="19"
                               FontAttributes="Bold"
                               Margin="16,24,16,8" />

                        <!-- Display name (Active - bound to EditDisplayNameCommand) -->
                        <Grid ColumnDefinitions="36, *" Padding="16,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShellModel.EditDisplayNameCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="#9CA3AF"
                                    Padding="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Path Fill="#000000"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M8,8 C9.66,8 11,6.66 11,5 C11,3.34 9.66,2 8,2 C6.34,2 5,3.34 5,5 C5,6.66 6.34,8 8,8 Z M8,9.5 C5.67,9.5 1,10.67 1,13 L1,14.5 L15,14.5 L15,13 C15,10.67 10.33,9.5 8,9.5 Z" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="6,0,0,0">
                                <Label Text="Display name"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding ShellModel.CurrentUser.DisplayName}"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Username (Active - bound to EditUsernameCommand) -->
                        <Grid ColumnDefinitions="36, *" Padding="16,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShellModel.EditUsernameCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="#9CA3AF"
                                    Padding="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Path Fill="#000000"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M8,1.5 C4.41,1.5 1.5,4.41 1.5,8 C1.5,11.59 4.41,14.5 8,14.5 L11,14.5 L11,13 L8,13 C5.24,13 3,10.76 3,8 C3,5.24 5.24,3 8,3 C10.76,3 13,5.24 13,8 L13,8.9 C13,9.5 12.55,10 12,10 C11.45,10 11,9.5 11,8.9 L11,8 C11,6.34 9.66,5 8,5 C6.34,5 5,6.34 5,8 C5,9.66 6.34,11 8,11 C8.85,11 9.62,10.65 10.17,10.08 C10.6,10.92 11.25,11.5 12,11.5 C13.38,11.5 14.5,10.33 14.5,8.9 L14.5,8 C14.5,4.41 11.59,1.5 8,1.5 Z M8,6.5 C8.83,6.5 9.5,7.17 9.5,8 C9.5,8.83 8.83,9.5 8,9.5 C7.17,9.5 6.5,8.83 6.5,8 C6.5,7.17 7.17,6.5 8,6.5 Z" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="6,0,0,0">
                                <Label Text="Username"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding ShellModel.CurrentUser.Username, StringFormat='@{0}'}"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Change email address (Unimplemented feature - noted) -->
                        <Grid IsVisible="False" ColumnDefinitions="36, *" Padding="16,12">
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M16,2 C17.1,2 18,2.9 18,4 L18,14 C18,15.1 17.1,16 16,16 L2,16 C0.9,16 0,15.1 0,14 L0,4 C0,2.9 0.9,2 2,2 L16,2 Z M16,4 L9,9 L2,4 L2,6 L9,11 L16,6 L16,4 Z" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="6,0,0,0">
                                <Label Text="Change email address"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="yunus.cakir@protonmail.com"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ========================================== -->
                        <!-- Section: Camera                       -->
                        <!-- ========================================== -->
                        <Label Text="Camera"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="19"
                               FontAttributes="Bold"
                               Margin="16,24,16,8" />

                        <!-- True-color capture (Active - shutter saves the exact preview frame when ON, native still capture when OFF) -->
                        <Grid ColumnDefinitions="36, *, Auto" Padding="16,12">
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M6,1 L12,1 L13.5,3 L16,3 C17.1,3 18,3.9 18,5 L18,14 C18,15.1 17.1,16 16,16 L2,16 C0.9,16 0,15.1 0,14 L0,5 C0,3.9 0.9,3 2,3 L4.5,3 Z M9,5.5 C6.79,5.5 5,7.29 5,9.5 C5,11.71 6.79,13.5 9,13.5 C11.21,13.5 13,11.71 13,9.5 C13,7.29 11.21,5.5 9,5.5 Z M9,7.5 C10.1,7.5 11,8.4 11,9.5 C11,10.6 10.1,11.5 9,11.5 C7.9,11.5 7,10.6 7,9.5 C7,8.4 7.9,7.5 9,7.5 Z" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="6,0,10,0">
                                <Label Text="True-color capture"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Send photos exactly as seen in the viewfinder"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14" />
                            </VerticalStackLayout>
                            <!-- Custom Locket Gold Toggle Pill -->
                            <Border Grid.Column="2"
                                    WidthRequest="54"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{DynamicResource AccentColor}"
                                    Padding="3"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShellModel.ToggleCaptureFromPreviewCommand}" />
                                </Border.GestureRecognizers>
                                <Border WidthRequest="26"
                                        HeightRequest="26"
                                        StrokeShape="RoundRectangle 13"
                                        StrokeThickness="0"
                                        BackgroundColor="#FFFFFF"
                                        Padding="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsCaptureFromPreview}" Value="False">
                                            <Setter Property="HorizontalOptions" Value="Start" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsCaptureFromPreview}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#3A3A3C" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>

                        <!-- Camera engine (Android only - CameraX/Camera2 when ON, legacy Camera1 when OFF; applies after restart) -->
                        <Grid ColumnDefinitions="36, *, Auto" Padding="16,12" IsVisible="{OnPlatform Default=False, Android=True}">
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M2,1 L16,1 C17.1,1 18,1.9 18,3 L18,15 C18,16.1 17.1,17 16,17 L2,17 C0.9,17 0,16.1 0,15 L0,3 C0,1.9 0.9,1 2,1 Z M2,3 L2,15 L16,15 L16,3 Z M4,5 L8,5 L8,7 L4,7 Z M4,9 L14,9 L14,11 L4,11 Z M10,5 L14,5 L14,7 L10,7 Z M4,12 L11,12 L11,13.5 L4,13.5 Z" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="6,0,10,0">
                                <Label Text="New camera (beta)"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Smoother zoom and brightness. Restart to apply"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    WidthRequest="54"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{DynamicResource AccentColor}"
                                    Padding="3"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShellModel.ToggleCameraXEngineCommand}" />
                                </Border.GestureRecognizers>
                                <Border WidthRequest="26"
                                        HeightRequest="26"
                                        StrokeShape="RoundRectangle 13"
                                        StrokeThickness="0"
                                        BackgroundColor="#FFFFFF"
                                        Padding="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsCameraXEngine}" Value="False">
                                            <Setter Property="HorizontalOptions" Value="Start" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsCameraXEngine}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#3A3A3C" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>

                        <!-- Zoom slider (Active - vertical zoom slider on the right of the viewfinder after tap-to-focus) -->
                        <Grid ColumnDefinitions="36, *, Auto" Padding="16,12">
                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
