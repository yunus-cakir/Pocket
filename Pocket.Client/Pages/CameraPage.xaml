                            <!-- Row 1: Camera Viewfinder Rounded Square Card -->
                            <Border x:Name="CameraCardBorder"
                                    Grid.Row="1"
                                    WidthRequest="{Binding CardSize}"
                                    HeightRequest="{Binding CardSize}"
                                    Margin="6,4,6,0"
                                    StrokeShape="RoundRectangle 44"
                                    StrokeThickness="0"
                                    BackgroundColor="#000000"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start">
                                <Grid>
                                    <controls:CameraView x:Name="cameraView" HorizontalOptions="Fill" VerticalOptions="Fill">
                                        <controls:CameraView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCameraViewTapped" />
                                        </controls:CameraView.GestureRecognizers>
                                    </controls:CameraView>

                                    <!-- Tap-to-focus indicator ring (positioned in code-behind) -->
                                    <Border x:Name="FocusRing"
                                            IsVisible="False"
                                            InputTransparent="True"
                                            WidthRequest="64"
                                            HeightRequest="64"
                                            StrokeShape="RoundRectangle 32"
                                            Stroke="#FFFFFF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start" />

                                    <!-- Vertical zoom slider (right) - shown after tap-to-focus when enabled in Settings > General -->
                                    <VerticalStackLayout x:Name="ZoomSliderPanel"
                                                         InputTransparent="True"
                                                         IsVisible="False"
                                                         Opacity="0"
                                                         Spacing="4"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="Center"
                                                         Margin="0,0,10,0">
                                        <Border x:Name="ZoomResetButton"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                StrokeShape="RoundRectangle 16"
                                                StrokeThickness="0"
                                                BackgroundColor="#66000000"
                                                Padding="0"
                                                HorizontalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnResetZoomTapped" />
                                            </Border.GestureRecognizers>
                                            <Path WidthRequest="24"
                                                  HeightRequest="24"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M 5.5,9.5 C 6.6,6.8 9.1,5 12,5 C 15.9,5 19,8.1 19,12 C 19,15.9 15.9,19 12,19 C 9.8,19 7.8,18 6.5,16.4 M 3.5,5.5 L 5.2,9.8 L 9.5,8.5" />
                                        </Border>
                                        <Grid x:Name="ZoomValueBadgeSlot"
                                              HeightRequest="24"
                                              HorizontalOptions="Center"
                                              InputTransparent="True">
                                            <Border x:Name="ZoomValueBadge"
                                                    BackgroundColor="#66000000"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="6,2"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    InputTransparent="True">
                                                <Label x:Name="ZoomValueLabel" Text="1.0x" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="12" FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                        <controls:CameraSlider x:Name="ZoomSlider"
                                                               IsVertical="True"
                                                               WidthRequest="36"
                                                               HeightRequest="180"
                                                               HorizontalOptions="Center"
                                                               ValueChanged="OnZoomSliderValueChanged"
                                                               DragStarted="OnSliderDragStarted"
                                                               DragCompleted="OnSliderDragCompleted" />
                                    </VerticalStackLayout>

                                    <!-- Horizontal exposure slider (bottom) - shown after tap-to-focus when enabled in Settings > General -->
                                    <Grid x:Name="ExposureSliderPanel"
                                          InputTransparent="True"
                                          IsVisible="False"
                                          Opacity="0"
                                          ColumnDefinitions="Auto, *"
                                          ColumnSpacing="8"
                                          HorizontalOptions="Fill"
                                          VerticalOptions="End"
                                          Margin="32,0,32,12">
                                        <Border x:Name="ExposureResetButton"
                                                Grid.Column="0"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                StrokeShape="RoundRectangle 16"
                                                StrokeThickness="0"
                                                BackgroundColor="#66000000"
                                                Padding="0"
                                                VerticalOptions="End"
                                                Margin="0,0,0,2">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnResetExposureTapped" />
                                            </Border.GestureRecognizers>
                                            <Path WidthRequest="24"
                                                  HeightRequest="24"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M 5.5,9.5 C 6.6,6.8 9.1,5 12,5 C 15.9,5 19,8.1 19,12 C 19,15.9 15.9,19 12,19 C 9.8,19 7.8,18 6.5,16.4 M 3.5,5.5 L 5.2,9.8 L 9.5,8.5" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             HorizontalOptions="Fill"
                                                             VerticalOptions="End">
                                            <Grid x:Name="ExposureValueBadgeSlot"
                                                  HeightRequest="24"
                                                  HorizontalOptions="Center"
                                                  InputTransparent="True">
                                                <Border x:Name="ExposureValueBadge"
                                                        BackgroundColor="#66000000"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="6,2"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        InputTransparent="True">
                                                    <Label x:Name="ExposureValueLabel"
                                                           Text="0.0 EV"
                                                           TextColor="#FFFFFF"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center" />
                                                </Border>
                                            </Grid>
                                            <controls:CameraSlider x:Name="ExposureSlider"
                                                                   ShowCenterTick="True"
                                                                   HeightRequest="36"
                                                                   HorizontalOptions="Fill"
                                                                   ValueChanged="OnExposureSliderValueChanged"
                                                                   DragStarted="OnSliderDragStarted"
                                                                   DragCompleted="OnSliderDragCompleted" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Image Source="{Binding CapturedImagePath}" IsVisible="{Binding IsPreviewing}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPreviewImageTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <!-- Top-Left Flash Button (Live Camera only, hidden on Preview) -->
                                    <Border x:Name="FlashButtonBorder"
                                            IsVisible="{Binding IsNotPreviewing}"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            StrokeShape="RoundRectangle 19"
                                            StrokeThickness="0"
                                            BackgroundColor="#4D000000"
                                            Padding="0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="18,18,0,0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFlashTapped" />
                                        </Border.GestureRecognizers>
                                        <Path x:Name="FlashButtonIcon"
                                              WidthRequest="15"
                                              HeightRequest="18"
                                              Fill="#FFFFFF"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M9,0 L1,10 L7,10 L5,18 L14,7.5 L8,7.5 L9,0 Z" />
                                    </Border>

                                    <!-- Orientation Lock Button (Below Flash Button; appears for 5s when device rotates, stays visible when locked) -->
                                    <Border x:Name="OrientationLockButtonBorder"
                                            IsVisible="False"
                                            Opacity="0"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            StrokeShape="RoundRectangle 19"
                                            StrokeThickness="0"
                                            BackgroundColor="#4D000000"
                                            Padding="0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="18,64,0,0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOrientationLockTapped" />
                                        </Border.GestureRecognizers>
                                        <Path x:Name="OrientationLockButtonIcon"
                                              WidthRequest="16"
                                              HeightRequest="18"
                                              Fill="#FFFFFF"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M 8,0 C 5.24,0 3,2.24 3,5 L 3,7 L 2,7 C 0.9,7 0,7.9 0,9 L 0,16 C 0,17.1 0.9,18 2,18 L 14,18 C 15.1,18 16,17.1 16,16 L 16,9 C 16,7.9 15.1,7 14,7 L 13,7 L 13,5 C 13,2.24 10.76,0 8,0 Z M 8,2 C 9.66,2 11,3.34 11,5 L 11,7 L 5,7 L 5,5 C 5,3.34 6.34,2 8,2 Z M 8,11 C 9.1,11 10,11.9 10,13 C 10,14.1 9.1,15 8,15 C 6.9,15 6,14.1 6,13 C 6,11.9 6.9,11 8,11 Z" />
                                    </Border>

                                    <!-- Caption Entry Pill Overlay when Previewing Captured Photo -->
                                    <Border x:Name="CaptionPillBorder"
                                            IsVisible="{Binding IsPreviewing}"
                                            BackgroundColor="#8C3C3C40"
                                            StrokeShape="RoundRectangle 22"
                                            StrokeThickness="0"
                                            Padding="18,0"
                                            Margin="20,0,20,18"
                                            HeightRequest="42"
                                            MinimumWidthRequest="156"
                                            HorizontalOptions="Center"
                                            VerticalOptions="End">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCaptionPillTapped" />
                                        </Border.GestureRecognizers>
                                        <controls:IncognitoEntry x:Name="CaptionEntry"
                                                                 Text="{Binding Caption}"
                                                                 Placeholder="Add a message"
                                                                 PlaceholderColor="#F3F4F6"
                                                                 TextColor="#FFFFFF"
                                                                 FontFamily="OpenSansSemibold"
                                                                 FontAttributes="Bold"
                                                                 FontSize="16"
                                                                 HorizontalTextAlignment="Center"
                                                                 BackgroundColor="Transparent"
                                                                 MinimumHeightRequest="38"
                                                                 MinimumWidthRequest="120"
                                                                 ReturnType="Done"
                                                                 Focused="OnCaptionEntryFocused"
                                                                 Unfocused="OnCaptionEntryUnfocused"
                                                                 Completed="OnCaptionEntryCompleted"
                                                                 VerticalOptions="Center"
                                                                 HorizontalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Row 2: Shutter Controls & Preview Send Controls -->
                            <Grid Grid.Row="2" Padding="0">

                                <!-- Shutter Row (Live Camera Mode - Image 3) -->
                                <Grid IsVisible="{Binding IsNotPreviewing}"
                                      ColumnDefinitions="*, Auto, *"
                                      VerticalOptions="Center"
                                      Margin="0">

                                    <!-- Left: Stacked Photo Gallery Button (Opens standard Android Photo Picker) -->
                                    <Grid Grid.Column="0"
                                          WidthRequest="60"
                                          HeightRequest="60"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnGalleryTapped" />
                                        </Grid.GestureRecognizers>
                                        <Path WidthRequest="37"
                                              HeightRequest="36"
                                              Fill="#FFFFFF"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M4.2,23.5 L2.2,11.2 C1.5,7.2 4.1,3.5 8.1,2.8 L20.2,0.8 C23.3,0.3 26.2,1.8 27.6,4.5 L12.5,4.5 C7.8,4.5 4.2,8.1 4.2,12.8 L4.2,23.5 Z M13,7 L28,7 C31.9,7 35,10.1 35,14 L35,28 C35,31.9 31.9,35 28,35 L13,35 C9.1,35 6,31.9 6,28 L6,14 C6,10.1 9.1,7 13,7 Z M13,10.5 C11.1,10.5 9.5,12.1 9.5,14 L9.5,24.6 L13.8,20.8 C14.9,19.9 16.5,20 17.5,21 L19.8,23.3 L25.2,17.5 C26.3,16.3 28.1,16.3 29.2,17.5 L31.5,20 L31.5,14 C31.5,12.1 29.9,10.5 28,10.5 L13,10.5 Z M16,13.5 C17.9,13.5 19.5,15.1 19.5,17 C19.5,18.9 17.9,20.5 16,20.5 C14.1,20.5 12.5,18.9 12.5,17 C12.5,15.1 14.1,13.5 16,13.5 Z" />
                                    </Grid>

                                    <!-- Center: Locket Gold-Ring Shutter Button (Active) -->
                                    <Grid x:Name="ShutterButtonGrid"
                                          Grid.Column="1"
                                          WidthRequest="{Binding ShutterButtonSize}"
                                          HeightRequest="{Binding ShutterButtonSize}"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          BackgroundColor="Transparent"
                                          HandlerChanged="OnShutterButtonHandlerChanged">
                                        <Border x:Name="ShutterOuterRing"
                                                WidthRequest="{Binding ShutterOuterRingSize}"
                                                HeightRequest="{Binding ShutterOuterRingSize}"
                                                StrokeShape="RoundRectangle 45"
                                                Stroke="{DynamicResource AccentColor}"
                                                StrokeThickness="4.5"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                InputTransparent="True" />
                                        <Border x:Name="ShutterInnerCircle"
                                                WidthRequest="{Binding ShutterInnerCircleSize}"
                                                HeightRequest="{Binding ShutterInnerCircleSize}"
                                                StrokeShape="RoundRectangle 36"
                                                StrokeThickness="0"
                                                BackgroundColor="#FFFFFF"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                InputTransparent="True" />
                                    </Grid>

                                    <!-- Right: Camera Flip / Switch Button -->
                                    <Grid x:Name="FlipCameraButton"
                                          Grid.Column="2"
                                          WidthRequest="60"
                                          HeightRequest="60"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFlipCameraTapped" />
                                        </Grid.GestureRecognizers>
                                        <Path WidthRequest="34"
                                              HeightRequest="28"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="2.6"
                                              StrokeLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M 13.6,4.2 C 14.7,3.8 15.8,3.6 17,3.6 C 22.7,3.6 27.3,8.3 27.3,14 L 27.3,17.7 M 22.8,13.2 L 27.3,17.7 L 31.8,13.2 M 20.4,23.8 C 19.3,24.2 18.2,24.4 17,24.4 C 11.3,24.4 6.7,19.7 6.7,14 L 6.7,10.3 M 2.2,14.8 L 6.7,10.3 L 11.2,14.8" />
                                    </Grid>
                                </Grid>

                                <!-- Preview Mode Controls (Visible when photo is captured and keyboard is not active) -->
                                <Grid x:Name="PreviewControlsRow"
                                      IsVisible="{Binding ShowPreviewControls}"
                                      ColumnDefinitions="*, Auto, *"
                                      VerticalOptions="Center"
                                      Margin="0">
                                    <!-- Left: Plain White X Cancel Button -->
                                    <Grid Grid.Column="0"
                                          WidthRequest="56"
                                          HeightRequest="56"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CancelCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Path WidthRequest="20"
                                              HeightRequest="20"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="3.2"
                                              StrokeLineCap="Round"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Data="M1,1 L19,19 M19,1 L1,19" />
                                    </Grid>

                                    <!-- Center: Large Solid Grey Circle with Tilted Outlined Paper Airplane Icon.
                                         After a shutter capture it morphs in from the pressed shutter (code-behind). -->
                                    <Grid Grid.Column="1"
                                          WidthRequest="{Binding ShutterButtonSize}"
                                          HeightRequest="{Binding ShutterButtonSize}"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">
                                        <Border x:Name="SendButtonCircle"
                                                WidthRequest="{Binding ShutterButtonSize}"
                                                HeightRequest="{Binding ShutterButtonSize}"
                                                StrokeShape="RoundRectangle 46"
                                                StrokeThickness="0"
                                                BackgroundColor="#4E4E52"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SendCommand}" />
                                            </Border.GestureRecognizers>
                                            <Grid InputTransparent="True">
                                                <Path x:Name="SendButtonIcon"
                                                      WidthRequest="38"
                                                      HeightRequest="38"
                                                      Stroke="#FFFFFF"
                                                      StrokeThickness="2.8"
                                                      StrokeLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Margin="-4,2,0,0"
                                                      Data="M34,4 L4,16.5 L16.5,21.5 L34,4 Z M16.5,21.5 L21.5,34 L34,4" />
                                                <!-- "Sent" checkmark shown on the accent-colored circle after tapping send -->
                                                <Path x:Name="SendButtonCheck"
                                                      Opacity="0"
                                                      WidthRequest="34"
                                                      HeightRequest="28"
                                                      Stroke="#111111"
                                                      StrokeThickness="3.6"
                                                      StrokeLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Data="M3,14.5 L12,23.5 L31,4" />
                                            </Grid>
                                        </Border>

                                        <!-- Thickened shutter ring that thins inward and vanishes during the morph -->
                                        <Border x:Name="SendMorphRing"
                                                IsVisible="False"
                                                InputTransparent="True"
                                                StrokeShape="RoundRectangle 45"
                                                Stroke="{DynamicResource AccentColor}"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                    </Grid>

                                    <Grid Grid.Column="2" WidthRequest="56" HeightRequest="56" />
                                </Grid>

                            </Grid>

                            <!-- Row 3: Bottom Spacer for Persistent History & Bottom Bar -->
                            <BoxView Grid.Row="3" HeightRequest="{Binding CameraBottomSpacerHeight}" BackgroundColor="Transparent" Color="Transparent" />
                        </Grid>
                    </CollectionView.Header>

                    <!-- ITEM TEMPLATE: FEED / HISTORY POST VIEW (Reference Image 4) -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaPost">
                            <Grid HeightRequest="{Binding ViewportHeight}"
                                  RowDefinitions="Auto, Auto, Auto, *, Auto"
                                  BackgroundColor="#000000">

                                <!-- Row 0: Top Spacer -->
                                <BoxView Grid.Row="0" HeightRequest="{Binding TopHeaderHeight}" BackgroundColor="Transparent" Color="Transparent" />

                                <!-- Row 1: Feed Photo Rounded Square Card -->
                                <Border Grid.Row="1"
                                        WidthRequest="{Binding CardSize}"
                                        HeightRequest="{Binding CardSize}"
                                        Margin="6,4,6,0"
                                        StrokeShape="RoundRectangle 44"
                                        StrokeThickness="0"
                                        BackgroundColor="#141414"
                                        Padding="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Start">
                                    <Grid>
                                        <Image Source="{Binding MediaLocalPath}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />

                                        <!-- Optional Caption Pill Inside Bottom of Photo -->
                                        <Border IsVisible="{Binding Caption, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                BackgroundColor="#99000000"
                                                StrokeShape="RoundRectangle 18"
                                                StrokeThickness="0"
                                                Padding="16,8"
                                                Margin="20,0,20,16"
                                                HorizontalOptions="Center"
                                                VerticalOptions="End">
                                            <Label Text="{Binding Caption}"
                                                   TextColor="#FFFFFF"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   HorizontalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Author & Relative Time ("You  20h") or Upload / Waiting Status -->
                                <Grid Grid.Row="2"
                                      IsVisible="{Binding Source={x:Reference thisPage}, Path=BindingContext.IsReplyingToFeedPost, Converter={StaticResource InvertedBoolConverter}}"
                                      HorizontalOptions="Center"
                                      Margin="0,16,0,0">
                                    <HorizontalStackLayout IsVisible="{Binding ShowNormalAuthorRow}"
                                                           Spacing="8"
                                                           HorizontalOptions="Center">
                                        <Label Text="{Binding AuthorLabel}"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding RelativeTimeText}"
                                               TextColor="#8E8E93"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout IsVisible="{Binding IsPendingUpload}"
                                                           Spacing="8"
                                                           HorizontalOptions="Center">
                                        <controls:UploadSpinner WidthRequest="16"
                                                                HeightRequest="16"
                                                                IsRunning="{Binding IsPendingUpload}"
                                                                Color="#FFFFFF"
                                                                StrokeThickness="2.2"
                                                                VerticalOptions="Center" />
                                        <Label Text="{Binding UploadStatusText}"
                                               TextColor="#FFFFFF"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Row 3 & 4: Bottom Spacer for Persistent Activity/Reply Pill & Bottom Bar -->
                                <BoxView Grid.Row="3" BackgroundColor="Transparent" Color="Transparent" />
                                <BoxView Grid.Row="4" HeightRequest="{Binding FeedBottomSpacerHeight}" BackgroundColor="Transparent" Color="Transparent" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ============================================================== -->
                <!-- EMPTY FILTERED FEED OVERLAY (When selected filter has 0 posts) -->
                <!-- ============================================================== -->
                <Grid IsVisible="{Binding ShowEmptyFilteredFeedCard}"
                      RowDefinitions="Auto, Auto, Auto, *, Auto"
                      BackgroundColor="#000000"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Down" Command="{Binding CenterBottomTabTappedCommand}" />
                    </Grid.GestureRecognizers>
                    <BoxView Grid.Row="0" HeightRequest="{Binding TopHeaderHeight}" BackgroundColor="Transparent" Color="Transparent" />
                    <Border Grid.Row="1"
                            WidthRequest="{Binding CardSize}"
                            HeightRequest="{Binding CardSize}"
                            Margin="6,4,6,0"
                            StrokeShape="RoundRectangle 44"
                            StrokeThickness="0"
                            BackgroundColor="#141414"
                            Padding="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Start">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="No photos yet"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="Photos for this filter will appear here."
                                   TextColor="#8E8E93"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <BoxView Grid.Row="4" HeightRequest="{Binding FeedBottomSpacerHeight}" BackgroundColor="Transparent" Color="Transparent" />
                </Grid>

                <!-- ============================================================== -->
                <!-- REACTION EMOJI RAIN OVERLAY (Falls once per un-animated react) -->
                <!-- ============================================================== -->
                <Grid x:Name="ReactionEmojiRainOverlay"
                      IsVisible="False"
                      InputTransparent="True"
                      IsClippedToBounds="True"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />

                <!-- ============================================================== -->
                <!-- GRID GALLERY VIEW OVERLAY (3-Column Photo Grid)                -->
                <!-- ============================================================== -->
                <Grid x:Name="GridGalleryContainer"
                      IsVisible="{Binding IsGridGalleryOpen}"
                      RowDefinitions="Auto, *"
                      BackgroundColor="#000000"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <BoxView Grid.Row="0" HeightRequest="{Binding GalleryTopSpacerHeight}" BackgroundColor="Transparent" Color="Transparent" />
                    <CollectionView x:Name="GridGalleryCollectionView"
                                    Grid.Row="1"
                                    ItemsSource="{Binding FeedPosts}"
                                    BackgroundColor="#000000"
                                    Margin="3,4,3,0"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="32">
                                <Label Text="No photos yet"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                                <Label Text="Photos for this filter will appear here."
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="3"
                                             HorizontalItemSpacing="0"
                                             VerticalItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaPost">
                                <Grid HeightRequest="{Binding GridItemSize}"
                                      Padding="2.5">
                                    <Border StrokeShape="RoundRectangle 22"
                                            StrokeThickness="0"
                                            BackgroundColor="#141414"
                                            Padding="0"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectFromGridCommand}" />
                                        </Border.GestureRecognizers>
                                        <Image Source="{Binding MediaLocalPath}"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <BoxView HeightRequest="90" BackgroundColor="Transparent" Color="Transparent" />
                        </CollectionView.Footer>
                    </CollectionView>
                </Grid>

                <!-- ============================================================== -->
                <!-- FILTER DROPDOWN MENU OVERLAY ("All Friends", Friends, "You")   -->
                <!-- ============================================================== -->
                <Grid x:Name="FilterMenuOverlayGrid"
                      IsVisible="False"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <!-- Backdrop to dismiss filter menu when tapping outside -->
                    <BoxView x:Name="FilterMenuBackdrop"
                             BackgroundColor="#55000000"
                             Color="#55000000"
                             Opacity="0"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterMenuBackdropTapped" />
                        </BoxView.GestureRecognizers>
                    </BoxView>

                    <!-- Floating Rounded Dropdown Card below Top Filter Pill -->
                    <Border x:Name="FilterMenuCard"
                            WidthRequest="284"
                            Margin="{Binding FilterMenuMargin}"
                            HorizontalOptions="Center"
                            VerticalOptions="Start"
                            BackgroundColor="#3D3D40"
                            StrokeShape="RoundRectangle 28"
                            StrokeThickness="0"
                            Padding="0"
                            Opacity="0"
                            Scale="0.92">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Start">

                            <!-- Option 1: "All Friends" -->
                            <Grid ColumnDefinitions="Auto, *, Auto"
                                  ColumnSpacing="14"
                                  Padding="16,10"
                                  BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectFilterAllFriendsCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        StrokeShape="RoundRectangle 21"
                                        StrokeThickness="0"
                                        BackgroundColor="#5A5A5E"
                                        Padding="0"
                                        VerticalOptions="Center">
                                    <Path WidthRequest="19"
                                          HeightRequest="16"
                                          Fill="#E5E5EA"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Data="M7,7 C8.66,7 10,5.66 10,4 C10,2.34 8.66,1 7,1 C5.34,1 4,2.34 4,4 C4,5.66 5.34,7 7,7 Z M13.5,7.5 C14.88,7.5 16,6.38 16,5 C16,3.62 14.88,2.5 13.5,2.5 C12.12,2.5 11,3.62 11,5 C11,6.38 12.12,7.5 13.5,7.5 Z M7,9 C4.33,9 0,10.34 0,13 L0,14.5 L14,14.5 L14,13 C14,10.34 9.67,9 7,9 Z M13.5,9.5 C13,9.5 12.4,9.55 11.8,9.65 C13,10.5 13.8,11.65 13.8,13 L13.8,14.5 L19,14.5 L19,13 C19,10.9 15.8,9.5 13.5,9.5 Z" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="All Friends"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Path Grid.Column="2"
                                      WidthRequest="9"
                                      HeightRequest="15"
                                      Stroke="#9A9AA0"
                                      StrokeThickness="2.4"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      VerticalOptions="Center"
                                      Margin="0,0,4,0"
                                      Data="M1,1 L7.5,7.5 L1,14" />
                            </Grid>

                            <!-- Dynamic Friend Rows -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ShellModel.Friends}"
                                                 Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Friend">
                                        <VerticalStackLayout Spacing="0">
                                            <BoxView HeightRequest="1" BackgroundColor="#525256" Color="#525256" />
                                            <Grid ColumnDefinitions="Auto, *, Auto"
                                                  ColumnSpacing="14"
                                                  Padding="16,10"
                                                  BackgroundColor="Transparent">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectFilterFriendCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Border Grid.Column="0"
                                                        WidthRequest="42"
                                                        HeightRequest="42"
                                                        StrokeShape="RoundRectangle 21"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#2C2C2E"
                                                        Padding="0"
                                                        VerticalOptions="Center">
                                                    <Grid>
                                                        <Path Fill="#8E8E93"
                                                              HorizontalOptions="Center"
                                                              VerticalOptions="Center"
                                                              Scale="0.95"
                                                              Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                                        <Image Source="{Binding ProfilePictureUrl}"
                                                               IsVisible="{Binding ProfilePictureUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                               Aspect="AspectFill" />
                                                    </Grid>
                                                </Border>
                                                <Label Grid.Column="1"
                                                       Text="{Binding FirstName}"
                                                       TextColor="#FFFFFF"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="17"
                                                       FontAttributes="Bold"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                                <Path Grid.Column="2"
                                                      WidthRequest="9"
                                                      HeightRequest="15"
                                                      Stroke="#9A9AA0"
                                                      StrokeThickness="2.4"
                                                      StrokeLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      VerticalOptions="Center"
                                                      Margin="0,0,4,0"
                                                      Data="M1,1 L7.5,7.5 L1,14" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Last Option: "You" -->
                            <BoxView HeightRequest="1" BackgroundColor="#525256" Color="#525256" />
                            <Grid ColumnDefinitions="Auto, *, Auto"
                                  ColumnSpacing="14"
                                  Padding="16,10"
                                  BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectFilterYouCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        StrokeShape="RoundRectangle 21"
                                        StrokeThickness="0"
                                        BackgroundColor="#2C2C2E"
                                        Padding="0"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Path Fill="#8E8E93"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Scale="0.95"
                                              Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                        <Image Source="{Binding ShellModel.CurrentUser.ProfilePictureUrl}"
                                               IsVisible="{Binding ShellModel.CurrentUser.ProfilePictureUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                               Aspect="AspectFill" />
                                    </Grid>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="You"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Path Grid.Column="2"
                                      WidthRequest="9"
                                      HeightRequest="15"
                                      Stroke="#9A9AA0"
                                      StrokeThickness="2.4"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      VerticalOptions="Center"
                                      Margin="0,0,4,0"
                                      Data="M1,1 L7.5,7.5 L1,14" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- PERSISTENT TOP OVERLAY BAR ON CAMERA/FEED (Images 3 & 4)       -->
                <!-- ============================================================== -->
                <Grid IsVisible="{Binding IsTopOverlayBarVisible}"
                      ColumnDefinitions="Auto, *, Auto"
                      Margin="{Binding TopOverlayMargin}"
                      VerticalOptions="Start">

                    <!-- Left: Empty spacer to balance layout and keep center pill centered -->
                    <BoxView Grid.Column="0"
                             WidthRequest="42"
                             HeightRequest="42"
                             BackgroundColor="Transparent"
                             Color="Transparent"
                             InputTransparent="True" />

                    <!-- Center Mode A: "1 Friend" Pill on Camera (Image 3) -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding ShowCameraFriendsPill}"
                            BackgroundColor="#1C1C1E"
                            StrokeShape="RoundRectangle 21"
                            StrokeThickness="0"
                            HeightRequest="42"
                            Padding="18,0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShellModel.AddFriendCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <!-- People Icon -->
                            <Path WidthRequest="19"
                                  HeightRequest="16"
                                  Fill="#FFFFFF"
                                  VerticalOptions="Center"
                                  Data="M7,7 C8.66,7 10,5.66 10,4 C10,2.34 8.66,1 7,1 C5.34,1 4,2.34 4,4 C4,5.66 5.34,7 7,7 Z M13.5,7.5 C14.88,7.5 16,6.38 16,5 C16,3.62 14.88,2.5 13.5,2.5 C12.12,2.5 11,3.62 11,5 C11,6.38 12.12,7.5 13.5,7.5 Z M7,9 C4.33,9 0,10.34 0,13 L0,14.5 L14,14.5 L14,13 C14,10.34 9.67,9 7,9 Z M13.5,9.5 C13,9.5 12.4,9.55 11.8,9.65 C13,10.5 13.8,11.65 13.8,13 L13.8,14.5 L19,14.5 L19,13 C19,10.9 15.8,9.5 13.5,9.5 Z" />
                            <Label Text="{Binding ShellModel.FriendsCountText}"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Center Mode B: Filter Pill on Feed & Grid Gallery ("All Friends ⌄" / "You ^" / Friend Name) -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding ShowFeedFilterPill}"
                            BackgroundColor="#1C1C1E"
                            StrokeShape="RoundRectangle 21"
                            StrokeThickness="0"
                            HeightRequest="42"
                            Padding="18,0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFilterMenuCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding SelectedFilterTitle}"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   MaximumWidthRequest="170"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFilterMenuOpen}" Value="True">
                                        <Setter Property="TextColor" Value="#D1D5DB" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <!-- Chevron Down when closed -->
                            <Path IsVisible="{Binding IsFilterMenuOpen, Converter={StaticResource InvertedBoolConverter}}"
                                  WidthRequest="11"
                                  HeightRequest="7"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2.2"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalOptions="Center"
                                  Margin="0,2,0,0"
                                  Data="M1,1 L5.5,5.5 L10,1" />
                            <!-- Chevron Up when open -->
                            <Path IsVisible="{Binding IsFilterMenuOpen}"
                                  WidthRequest="11"
                                  HeightRequest="7"
                                  Stroke="#D1D5DB"
                                  StrokeThickness="2.2"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalOptions="Center"
                                  Margin="0,1,0,0"
                                  Data="M1,5.5 L5.5,1 L10,5.5" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Right: Circular User Profile Avatar (Active - Opens Add Friends) -->
                    <Border Grid.Column="2"
                            WidthRequest="42"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 21"
                            StrokeThickness="0"
                            BackgroundColor="#1C1C1E"
                            Padding="0"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShellModel.AddFriendCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Path WidthRequest="24"
                                  HeightRequest="24"
                                  Fill="#8E8E93"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Scale="0.95"
                                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                            <Image Source="{Binding ShellModel.CurrentUser.ProfilePictureUrl}"
                                   IsVisible="{Binding ShellModel.CurrentUser.ProfilePictureUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                   Aspect="AspectFill" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- PREVIEW TOP OVERLAY BAR ("Send to..." + Save to Gallery Icon)  -->
                <!-- ============================================================== -->
                <Grid x:Name="PreviewTopOverlay"
                      IsVisible="{Binding ShowPreviewControls}"
                      ColumnDefinitions="42, *, 42"
                      Margin="{Binding TopOverlayMargin}"
                      VerticalOptions="Start">
                    <BoxView Grid.Column="0" BackgroundColor="Transparent" Color="Transparent" />

                    <Label Grid.Column="1"
                           Text="Send to..."
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <!-- Right: Save to Gallery Icon (Hidden when photo is selected from gallery) -->
                    <Grid Grid.Column="2"
                          IsVisible="{Binding ShowSaveToGalleryButton}"
                          WidthRequest="42"
                          HeightRequest="42"
                          BackgroundColor="Transparent"
                          HorizontalOptions="End"
                          VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SaveCapturedPreviewToGalleryCommand}" />
                        </Grid.GestureRecognizers>
                        <Path Stroke="#D1D5DB"
                              StrokeThickness="2.5"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True"
                              Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,15 L4,18 C4,19.66 5.34,21 7,21 L17,21 C18.66,21 20,19.66 20,18 L20,15" />
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- PREVIEW BOTTOM OVERLAY BAR (Recipient Selector: "All", Friends)-->
                <!-- ============================================================== -->
                <ScrollView x:Name="PreviewRecipientsScroll"
                            IsVisible="{Binding ShowPreviewControls}"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            HorizontalOptions="Center"
                            VerticalOptions="End"
                            Margin="{Binding PreviewBottomOverlayMargin}">
                    <HorizontalStackLayout Spacing="22" HorizontalOptions="Center" VerticalOptions="End">

                        <!-- "All" Option -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectAllRecipientsCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Border WidthRequest="46"
                                    HeightRequest="46"
                                    StrokeShape="RoundRectangle 23"
                                    Stroke="{DynamicResource AccentColor}"
                                    StrokeThickness="2.5"
                                    BackgroundColor="#000000"
                                    Padding="3"
                                    HorizontalOptions="Center">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAllSelected}" Value="False">
                                        <Setter Property="Stroke" Value="#2C2C2E" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border WidthRequest="36"
                                        HeightRequest="36"
                                        StrokeShape="RoundRectangle 18"
                                        StrokeThickness="0"
                                        BackgroundColor="#3A3A3C"
                                        Padding="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <!-- Two People Group Icon -->
                                    <Path Fill="#FFFFFF"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Scale="0.85"
                                          Data="M7,7 C8.66,7 10,5.66 10,4 C10,2.34 8.66,1 7,1 C5.34,1 4,2.34 4,4 C4,5.66 5.34,7 7,7 Z M13.5,7.5 C14.88,7.5 16,6.38 16,5 C16,3.62 14.88,2.5 13.5,2.5 C12.12,2.5 11,3.62 11,5 C11,6.38 12.12,7.5 13.5,7.5 Z M7,9 C4.33,9 0,10.34 0,13 L0,14.5 L14,14.5 L14,13 C14,10.34 9.67,9 7,9 Z M13.5,9.5 C13,9.5 12.4,9.55 11.8,9.65 C13,10.5 13.8,11.65 13.8,13 L13.8,14.5 L19,14.5 L19,13 C19,10.9 15.8,9.5 13.5,9.5 Z" />
                                </Border>
                            </Border>
                            <Label Text="All"
                                   TextColor="{DynamicResource AccentColor}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13.5"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsAllSelected}" Value="False">
                                        <Setter Property="TextColor" Value="#8E8E93" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Friends List -->
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ShellModel.Friends}"
                                               Spacing="22"
                                               VerticalOptions="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Friend">
                                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.ToggleRecipientCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Border WidthRequest="46"
                                                HeightRequest="46"
                                                StrokeShape="RoundRectangle 23"
                                                Stroke="#2C2C2E"
                                                StrokeThickness="2.5"
                                                BackgroundColor="#000000"
                                                Padding="3"
                                                HorizontalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelectedForSend}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border WidthRequest="36"
                                                    HeightRequest="36"
                                                    StrokeShape="RoundRectangle 18"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#2C2C2E"
                                                    Padding="0"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                <Grid>
                                                    <Path Fill="#8E8E93"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center"
                                                          Scale="0.9"
                                                          Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                                    <Image Source="{Binding ProfilePictureUrl}"
                                                           IsVisible="{Binding ProfilePictureUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                           Aspect="AspectFill" />
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <Label Text="{Binding DisplayName}"
                                               TextColor="#8E8E93"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13.5"
                                               FontAttributes="Bold"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               MaximumWidthRequest="76"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelectedForSend}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ============================================================== -->
                <!-- PERSISTENT BOTTOM OVERLAY ON CAMERA/FEED (History & Activity)  -->
                <!-- ============================================================== -->
                <Grid IsVisible="{Binding IsNotPreviewing}"
                      Margin="{Binding HistoryOverlayMargin}"
                      HorizontalOptions="Fill"
                      VerticalOptions="End">

                    <!-- History ⌄ Button (Visible on Camera Screen right above Bottom Pill - Image 3) -->
                    <HorizontalStackLayout IsVisible="{Binding ShowHistoryButton}"
                                           Spacing="6"
                                           HorizontalOptions="Center"
                                           Padding="12,4">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ScrollToHistoryCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Border IsVisible="{Binding ShellModel.HasUnseenPhotos}"
                                BackgroundColor="{DynamicResource AccentColor}"
                                StrokeShape="RoundRectangle 7"
                                StrokeThickness="0"
                                MinimumWidthRequest="25"
                                HeightRequest="25"
                                Padding="6,0"
                                Margin="0,0,4,0"
                                VerticalOptions="Center">
                            <Label Text="{Binding ShellModel.UnseenPhotoCount}"
                                   TextColor="#111111"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="History"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Path Stroke="#FFFFFF"
                              StrokeThickness="2.2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              VerticalOptions="Center"
                              Margin="0,2,0,0"
                              Data="M1,1 L6,6 L11,1" />
                    </HorizontalStackLayout>

                    <!-- Feed Activity Pill ("✨ No activity yet!") or Incoming Reply/React Bar ("Send message...") -->
                    <Grid IsVisible="{Binding ShowFeedOverlayBar}"
                          HorizontalOptions="Fill">

                        <!-- Own Post (No Activity): "✨ No activity yet!" Pill (Reference Image 4) -->
                        <Border IsVisible="{Binding ShowFeedNoActivityPill}"
                                BackgroundColor="#1C1C1E"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                HeightRequest="44"
                                Padding="18,0"
                                HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Path Fill="#9CA3AF"
                                      VerticalOptions="Center"
                                      Data="M9,0 L11,5.5 L16.5,7.5 L11,9.5 L9,15 L7,9.5 L1.5,7.5 L7,5.5 L9,0 Z M3,11 L3.8,13.2 L6,14 L3.8,14.8 L3,17 L2.2,14.8 L0,14 L2.2,13.2 L3,11 Z" />
                                <Label Text="No activity yet!"
                                       TextColor="#9CA3AF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Own Post (Has Activity): Shows "[Avatar] Yunus sent ❤️🔥" while reaction animation plays, then "✨ Activity [Avatar]" -->
                        <Border IsVisible="{Binding ShowFeedActivityPill}"
                                BackgroundColor="#222224"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                HeightRequest="48"
                                Padding="16,0,10,0"
                                HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenActivitySheetCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsReactionSentPillVisible}" Value="True">
                                    <Setter Property="Padding" Value="10,0,16,0" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid VerticalOptions="Center">
                                <!-- Default Activity Pill Content ("✨ Activity [Avatar]") -->
                                <HorizontalStackLayout IsVisible="{Binding IsDefaultActivityPillVisible}"
                                                       Spacing="10"
                                                       VerticalOptions="Center">
                                    <Path Fill="#C7C7CC"
                                          VerticalOptions="Center"
                                          Data="M9,0 L11,5.5 L16.5,7.5 L11,9.5 L9,15 L7,9.5 L1.5,7.5 L7,5.5 L9,0 Z M3,11 L3.8,13.2 L6,14 L3.8,14.8 L3,17 L2.2,14.8 L0,14 L2.2,13.2 L3,11 Z" />
                                    <Label Text="Activity"
                                           TextColor="#C7C7CC"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Border WidthRequest="30"
                                            HeightRequest="30"
                                            StrokeShape="RoundRectangle 15"
                                            StrokeThickness="0"
                                            BackgroundColor="#3A3A3C"
                                            Padding="0"
                                            VerticalOptions="Center">
                                        <Grid>
                                            <Path Fill="#8E8E93"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Scale="0.7"
                                                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                            <Image Source="{Binding CurrentFeedPost.LatestActivityAvatarUrl}"
                                                   IsVisible="{Binding CurrentFeedPost.LatestActivityAvatarUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Active Reaction Animation Pill Content ("[Avatar] Yunus sent ❤️🔥") -->
                                <HorizontalStackLayout IsVisible="{Binding IsReactionSentPillVisible}"
                                                       Spacing="10"
                                                       VerticalOptions="Center">
                                    <Border WidthRequest="30"
                                            HeightRequest="30"
                                            StrokeShape="RoundRectangle 15"
                                            StrokeThickness="0"
                                            BackgroundColor="#3A3A3C"
                                            Padding="0"
                                            VerticalOptions="Center">
                                        <Grid>
                                            <Path Fill="#8E8E93"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Scale="0.7"
                                                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                            <Image Source="{Binding CurrentFeedPost.LatestActivityAvatarUrl}"
                                                   IsVisible="{Binding CurrentFeedPost.LatestActivityAvatarUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                    <Label Text="{Binding CurrentFeedPost.ActivityPillText}"
                                           TextColor="#FFFFFF"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Friend's Post: Wide Reply & Emoji Reactions Bar ("Send message...") -->
                        <Border IsVisible="{Binding ShowFeedReplyBar}"
                                BackgroundColor="#222224"
                                StrokeShape="RoundRectangle 26"
                                StrokeThickness="0"
                                HeightRequest="52"
                                Padding="22,0,18,0"
                                HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="*, Auto">
                                <!-- Left: Tappable "Send message..." area -->
                                <Grid Grid.Column="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CurrentFeedPost.ReplyCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="Send message..."
                                           TextColor="#9A9AA0"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16.5"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Right: Quick Emojis (most recently used first) + Add-Emoji Icon (😊+) -->
                                <HorizontalStackLayout Grid.Column="1" Spacing="14" VerticalOptions="Center">
                                    <Label Text="{Binding FirstRecentEmoji}" FontSize="23" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SendFirstRecentEmojiCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="{Binding SecondRecentEmoji}" FontSize="23" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SendSecondRecentEmojiCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="{Binding ThirdRecentEmoji}" FontSize="23" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SendThirdRecentEmojiCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Add-Emoji Picker Icon (😊+ - Opens Custom Emoji Picker Bottom Sheet) -->
                                    <Grid WidthRequest="30"
                                          HeightRequest="30"
                                          VerticalOptions="Center"
                                          Margin="2,0,0,0"
                                          BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenEmojiPickerCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Path Stroke="#C7C7CC"
                                              StrokeThickness="2.2"
                                              StrokeLineCap="Round"
                                              StrokeLineJoin="Round"
                                              InputTransparent="True"
                                              Data="M11.5,4 A8.5,8.5 0 1,0 20,12.5 M8.2,14.2 Q11.5,17.2 14.8,14.2 M16,5.5 L22,5.5 M19,2.5 L19,8.5" />
                                        <Ellipse WidthRequest="2.5"
                                                 HeightRequest="2.5"
                                                 Fill="#C7C7CC"
                                                 HorizontalOptions="Start"
                                                 VerticalOptions="Start"
                                                 InputTransparent="True"
                                                 Margin="7.5,9.5,0,0" />
                                        <Ellipse WidthRequest="2.5"
                                                 HeightRequest="2.5"
                                                 Fill="#C7C7CC"
                                                 HorizontalOptions="Start"
                                                 VerticalOptions="Start"
                                                 InputTransparent="True"
                                                 Margin="13,9.5,0,0" />
                                    </Grid>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- CUSTOM EMOJI PICKER BOTTOM SHEET OVERLAY                       -->
                <!-- ============================================================== -->
                <Grid x:Name="EmojiPickerOverlayGrid"
                      IsVisible="False"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <!-- Semi-transparent backdrop to dismiss emoji picker on tap outside -->
                    <BoxView x:Name="EmojiPickerBackdrop"
                             BackgroundColor="#66000000"
                             Color="#66000000"
                             Opacity="0"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEmojiPickerBackdropTapped" />
                        </BoxView.GestureRecognizers>
                    </BoxView>

                    <!-- Rounded Top Bottom Sheet Card -->
                    <Border x:Name="EmojiPickerSheetCard"
                            VerticalOptions="End"
                            HorizontalOptions="Fill"
                            HeightRequest="476"
                            TranslationY="500"
                            BackgroundColor="#202022"
                            StrokeShape="RoundRectangle 30,30,0,0"
                            StrokeThickness="0"
                            Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto, *">

                            <!-- Row 0: Search Bar Header (Also draggable downward to dismiss) -->
                            <Grid Grid.Row="0"
                                  BackgroundColor="Transparent"
                                  Padding="18,18,18,8">
                                <Grid.GestureRecognizers>
                                    <PanGestureRecognizer PanUpdated="OnEmojiPickerSheetPanUpdated" />
                                </Grid.GestureRecognizers>

                                <Border HeightRequest="44"
                                        StrokeShape="RoundRectangle 22"
                                        StrokeThickness="0"
                                        BackgroundColor="#323235"
                                        Padding="18,0,12,0"
                                        HorizontalOptions="Fill">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <controls:IncognitoEntry x:Name="EmojiSearchEntry"
                                                                 Grid.Column="0"
                                                                 Text="{Binding EmojiSearchText}"
                                                                 Placeholder="Search"
                                                                 PlaceholderColor="#8E8E93"
                                                                 TextColor="#FFFFFF"
                                                                 FontFamily="OpenSansRegular"
                                                                 FontSize="17"
                                                                 BackgroundColor="Transparent"
                                                                 ReturnType="Search"
                                                                 Focused="OnEmojiSearchEntryFocused"
                                                                 Unfocused="OnEmojiSearchEntryUnfocused"
                                                                 Completed="OnEmojiSearchEntryCompleted"
                                                                 VerticalOptions="Center"
                                                                 HorizontalOptions="Fill" />

                                        <Grid Grid.Column="1"
                                              IsVisible="{Binding HasEmojiSearchText}"
                                              WidthRequest="28"
                                              HeightRequest="28"
                                              BackgroundColor="Transparent"
                                              VerticalOptions="Center">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ClearEmojiSearchCommand}" />
                                            </Grid.GestureRecognizers>
                                            <Border WidthRequest="20"
                                                    HeightRequest="20"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#525256"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                <Path WidthRequest="8"
                                                      HeightRequest="8"
                                                      Stroke="#202022"
                                                      StrokeThickness="2"
                                                      StrokeLineCap="Round"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Data="M1,1 L7,7 M7,1 L1,7" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Row 1: Scrollable Categorized 6-Column Emoji List + Floating Bottom Category Bar -->
                            <Grid Grid.Row="1">
                                <CollectionView x:Name="EmojiPickerCollectionView"
                                                ItemsSource="{Binding EmojiPickerRows}"
                                                BackgroundColor="Transparent"
                                                SelectionMode="None"
                                                VerticalScrollBarVisibility="Never"
                                                Scrolled="OnEmojiPickerScrolled">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:EmojiListRow">
                                            <Grid>
                                                <!-- Category Section Header Row ("Smileys & Emotion", etc.) -->
                                                <Label IsVisible="{Binding IsHeader}"
                                                       Text="{Binding HeaderTitle}"
                                                       TextColor="#9A9AA0"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="16"
                                                       Margin="20,10,20,8"
                                                       VerticalOptions="Center" />

                                                <!-- 6-Column Emoji Row -->
                                                <Grid IsVisible="{Binding IsEmojiRow}"
                                                      ColumnDefinitions="*, *, *, *, *, *"
                                                      Padding="10,2"
                                                      HeightRequest="56">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Emoji0}"
                                                           IsVisible="{Binding HasEmoji0}"
                                                           FontSize="33"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
                                                                                  CommandParameter="{Binding Emoji0}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <Label Grid.Column="1"
                                                           Text="{Binding Emoji1}"
                                                           IsVisible="{Binding HasEmoji1}"
                                                           FontSize="33"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
                                                                                  CommandParameter="{Binding Emoji1}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <Label Grid.Column="2"
                                                           Text="{Binding Emoji2}"
                                                           IsVisible="{Binding HasEmoji2}"
                                                           FontSize="33"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
                                                                                  CommandParameter="{Binding Emoji2}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <Label Grid.Column="3"
                                                           Text="{Binding Emoji3}"
                                                           IsVisible="{Binding HasEmoji3}"
                                                           FontSize="33"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
                                                                                  CommandParameter="{Binding Emoji3}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <Label Grid.Column="4"
                                                           Text="{Binding Emoji4}"
                                                           IsVisible="{Binding HasEmoji4}"
                                                           FontSize="33"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
                                                                                  CommandParameter="{Binding Emoji4}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <Label Grid.Column="5"
                                                           Text="{Binding Emoji5}"
                                                           IsVisible="{Binding HasEmoji5}"
                                                           FontSize="33"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectEmojiFromPickerCommand}"
                                                                                  CommandParameter="{Binding Emoji5}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    <CollectionView.Footer>
                                        <BoxView HeightRequest="66" BackgroundColor="Transparent" Color="Transparent" />
                                    </CollectionView.Footer>
                                </CollectionView>

                                <!-- Floating Bottom Category Bar (9 Categories + Search Icon) -->
                                <Border x:Name="EmojiCategoryBarBorder"
                                        VerticalOptions="End"
                                        HorizontalOptions="Fill"
                                        Margin="18,0,18,12"
                                        HeightRequest="42"
                                        BackgroundColor="#E62C2C2E"
                                        StrokeShape="RoundRectangle 11"
                                        StrokeThickness="0"
                                        Padding="4,3">
                                    <Grid ColumnDefinitions="*, *, *, *, *, *, *, *, *, *">

                                        <!-- Category 0: Smileys & Emotion -->
                                        <Border Grid.Column="0"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="0" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat0Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M11,2 A9,9 0 1,0 11,20 A9,9 0 1,0 11,2 Z M7.5,9.5 L7.6,9.5 M14.4,9.5 L14.5,9.5 M7.5,13.5 Q11,16.8 14.5,13.5">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat0Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 1: People & Body -->
                                        <Border Grid.Column="1"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="1" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat1Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="20"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M8,9 A3.2,3.2 0 1,0 8,2.6 A3.2,3.2 0 1,0 8,9 Z M2.5,17.5 C2.5,14.2 5,12 8,12 C11,12 13.5,14.2 13.5,17.5 M15,9.5 A2.6,2.6 0 1,0 15,4.3 A2.6,2.6 0 1,0 15,9.5 Z M15,12.2 C17.5,12.2 19.5,14.2 19.5,17.2">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat1Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 2: Animals & Nature -->
                                        <Border Grid.Column="2"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="2" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat2Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M7.5,3 C4.7,3 2.5,5.5 2.5,8.5 C2.5,11.5 4.7,14 7.5,14 C10.3,14 12.5,11.5 12.5,8.5 C12.5,5.5 10.3,3 7.5,3 Z M7.5,10 L7.5,19 M15.5,5.5 C13.5,5.5 12,7.3 12,9.5 C12,11.7 13.5,13.5 15.5,13.5 C17.5,13.5 19,11.7 19,9.5 C19,7.3 17.5,5.5 15.5,5.5 Z M15.5,11 L15.5,19">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat2Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 3: Food & Drink -->
                                        <Border Grid.Column="3"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="3" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat3Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M11,2.5 C15,2.5 18.5,4.2 20,7 L11,19.5 L2,7 C3.5,4.2 7,2.5 11,2.5 Z M3.5,9 C6,7 8.5,6 11,6 C13.5,6 16,7 18.5,9 M9.5,10.5 L9.6,10.5 M12.8,11.5 L12.9,11.5 M10.8,14.5 L10.9,14.5">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat3Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 4: Travel & Places -->
                                        <Border Grid.Column="4"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="4" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat4Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M19.5,2.5 C20.2,3.2 20.2,4.3 19.5,5 L15,9.5 L18,18.5 L16,20.5 L11.5,13 L7.5,17 L8,20 L6.5,21.5 L4.5,17.5 L0.5,15.5 L2,14 L5,14.5 L9,10.5 L1.5,6 L3.5,4 L12.5,7 L17,2.5 C17.7,1.8 18.8,1.8 19.5,2.5 Z">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat4Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 5: Activities -->
                                        <Border Grid.Column="5"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="5" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat5Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M18.5,3.5 C13,2 6.5,4.5 3.8,9.8 C2,13.2 2,16.5 3.5,18.5 C5.5,20 8.8,20 12.2,18.2 C17.5,15.5 20,9 18.5,3.5 Z M8.5,13.5 L13.5,8.5 M9.2,10.2 L11.8,12.8 M10.8,8.6 L13.4,11.2">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat5Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 6: Objects -->
                                        <Border Grid.Column="6"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="6" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat6Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M11,2.5 C7.4,2.5 4.5,5.4 4.5,9 C4.5,11.4 5.8,13.5 7.8,14.6 L8.2,16.8 L13.8,16.8 L14.2,14.6 C16.2,13.5 17.5,11.4 17.5,9 C17.5,5.4 14.6,2.5 11,2.5 Z M8.8,19.5 L13.2,19.5">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat6Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 7: Symbols -->
                                        <Border Grid.Column="7"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="7" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat7Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M11,2.5 A8.5,8.5 0 1,0 11,19.5 A8.5,8.5 0 1,0 11,2.5 Z M5.2,5.2 L16.8,16.8">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat7Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Category 8: Flags -->
                                        <Border Grid.Column="8"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectEmojiCategoryCommand}" CommandParameter="8" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEmojiCat8Selected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#48484C" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M5,3 L5,19.5 M5,4 C7.5,2.8 10,5.2 12.5,4 C15,2.8 16.5,3.5 18,4 L18,12.5 C16.5,12 15,11.3 12.5,12.5 C10,13.7 7.5,11.3 5,12.5">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsEmojiCat8Selected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>

                                        <!-- Tab 9: Search Focus Button (🔍) -->
                                        <Border Grid.Column="9"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding FocusEmojiSearchCommand}" />
                                            </Border.GestureRecognizers>
                                            <Path WidthRequest="22"
                                                  HeightRequest="22"
                                                  Stroke="#7C7C82"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M9.5,3 A6.5,6.5 0 1,0 9.5,16 A6.5,6.5 0 1,0 9.5,3 Z M14.2,14.2 L19,19" />
                                        </Border>

                                    </Grid>
                                </Border>
                            </Grid>

                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- ACTIVITY BOTTOM SHEET OVERLAY (Reactions on Own Post)          -->
                <!-- ============================================================== -->
                <Grid x:Name="ActivityOverlayGrid"
                      IsVisible="False"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <!-- Semi-transparent backdrop to dismiss sheet on tap outside -->
                    <BoxView x:Name="ActivityBackdrop"
                             BackgroundColor="#77000000"
                             Color="#77000000"
                             Opacity="0"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActivityBackdropTapped" />
                        </BoxView.GestureRecognizers>
                    </BoxView>

                    <!-- Rounded Top Bottom Sheet Card -->
                    <Border x:Name="ActivitySheetCard"
                            VerticalOptions="End"
                            HorizontalOptions="Fill"
                            HeightRequest="380"
                            TranslationY="400"
                            BackgroundColor="#1C1C1E"
                            StrokeShape="RoundRectangle 32,32,0,0"
                            StrokeThickness="0"
                            Padding="20,10,20,24">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto, *">
                            <!-- Drag Header Area: Handle pill + Title (Pannable to drag down) -->
                            <Grid Grid.Row="0"
                                  RowDefinitions="Auto, Auto"
                                  BackgroundColor="Transparent"
                                  Padding="0,4,0,16">
                                <Grid.GestureRecognizers>
                                    <PanGestureRecognizer PanUpdated="OnActivitySheetPanUpdated" />
                                </Grid.GestureRecognizers>

                                <!-- Top Drag Handle Pill -->
                                <BoxView Grid.Row="0"
                                         WidthRequest="38"
                                         HeightRequest="5"
                                         CornerRadius="2.5"
                                         Color="#5A5A5E"
                                         BackgroundColor="#5A5A5E"
                                         HorizontalOptions="Center"
                                         Margin="0,0,0,14">
                                    <BoxView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnActivityBackdropTapped" />
                                    </BoxView.GestureRecognizers>
                                </BoxView>

                                <!-- Sheet Title: "Activity" -->
                                <Label Grid.Row="1"
                                       Text="Activity"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="19"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Grid>

                            <!-- Friends & Their Reactions List -->
                            <CollectionView Grid.Row="1"
                                            ItemsSource="{Binding CurrentFeedPost.ActivityItems}"
                                            BackgroundColor="Transparent"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PostActivityItem">
                                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,8">
                                            <Border Grid.Column="0"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeShape="RoundRectangle 22"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#2C2C2E"
                                                    Padding="0"
                                                    VerticalOptions="Center">
                                                <Grid>
                                                    <Path Fill="#8E8E93"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center"
                                                          Scale="0.95"
                                                          Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                                    <Image Source="{Binding FriendAvatarUrl}"
                                                           IsVisible="{Binding FriendAvatarUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                           Aspect="AspectFill" />
                                                </Grid>
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Text="{Binding FriendName}"
                                                   TextColor="#FFFFFF"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="17"
                                                   FontAttributes="Bold"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"
                                                   Margin="14,0,12,0" />

                                            <Label Grid.Column="2"
                                                   Text="{Binding EmojisText}"
                                                   FontSize="26"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- FEED REPLY OVERLAY ("Replying to [Name]" + "Reply to..." Pill) -->
                <!-- ============================================================== -->
                <Grid x:Name="FeedReplyOverlayGrid"
                      IsVisible="False"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <!-- Subtle darkened backdrop over the photo card -->
                    <BoxView x:Name="FeedReplyBackdrop"
                             BackgroundColor="#78000000"
                             Color="#78000000"
                             Opacity="0"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFeedReplyBackdropTapped" />
                        </BoxView.GestureRecognizers>
                    </BoxView>

                    <!-- Reply header & input pill anchored right above the keyboard -->
                    <VerticalStackLayout x:Name="FeedReplyContentStack"
                                         VerticalOptions="End"
                                         HorizontalOptions="Fill"
                                         Spacing="16"
                                         Opacity="0"
                                         TranslationY="60"
                                         Margin="0,0,0,14">

                        <!-- "Replying to [Friend]" Header with Avatar -->
                        <HorizontalStackLayout Spacing="12"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               InputTransparent="True">
                            <Border WidthRequest="42"
                                    HeightRequest="42"
                                    StrokeShape="RoundRectangle 21"
                                    StrokeThickness="0"
                                    BackgroundColor="#2C2C2E"
                                    Padding="0"
                                    VerticalOptions="Center">
                                <Grid>
                                    <Path Fill="#8E8E93"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Scale="0.95"
                                          Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                    <Image Source="{Binding ReplyingToFriendAvatarUrl}"
                                           IsVisible="{Binding ReplyingToFriendAvatarUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                           Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="Replying to"
                                       TextColor="#9A9AA0"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding ReplyingToFriendName}"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       Margin="0,-2,0,0" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Wide Reply Input Pill -->
                        <Border x:Name="FeedReplyPillBorder"
                                Margin="16,0,16,0"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                BackgroundColor="#28282B"
                                Padding="18,0,12,0"
                                HorizontalOptions="Fill">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeedReplyPillTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <controls:IncognitoEntry x:Name="FeedReplyEntry"
                                                         Grid.Column="0"
                                                         Text="{Binding FeedReplyText}"
                                                         Placeholder="{Binding FeedReplyPlaceholder}"
                                                         PlaceholderColor="#8E8E93"
                                                         TextColor="#FFFFFF"
                                                         FontFamily="OpenSansSemibold"
                                                         FontAttributes="Bold"
                                                         FontSize="17"
                                                         BackgroundColor="Transparent"
                                                         ReturnType="Send"
                                                         Completed="OnFeedReplyEntryCompleted"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="Fill" />

                                <Border Grid.Column="1"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17"
                                        StrokeThickness="0"
                                        BackgroundColor="#555558"
                                        Padding="0"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SendFeedReplyCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding HasFeedReplyText}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Path WidthRequest="16"
                                          HeightRequest="16"
                                          Stroke="#28282B"
                                          StrokeThickness="2.4"
                                          StrokeLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Data="M8,13 L8,3.5 M3.5,8 L8,3.5 L12.5,8" />
                                </Border>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Grid>

            </Grid>

            <!-- ================================================================== -->
            <!-- PANEL 2: CHAT LIST PAGE (Reference Image 2)                        -->
            <!-- ================================================================== -->
            <Grid x:Name="ChatPanel" Grid.Column="2" BackgroundColor="#000000" RowDefinitions="Auto, *, Auto">

                <!-- Row 0: Top Header ("Chat" centered + Top-Right Profile Avatar) -->
                <Grid Grid.Row="0" ColumnDefinitions="42, *, 42" Margin="{Binding ChatTopHeaderMargin}">
                    <BoxView Grid.Column="0" BackgroundColor="Transparent" Color="Transparent" />

                    <Label Grid.Column="1"
                           Text="Chat"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <BoxView Grid.Column="2" BackgroundColor="Transparent" Color="Transparent" />
                </Grid>

                <!-- Row 1: Chat / Friends List (Reference Image 2) -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding ShellModel.Friends}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="32">
                            <Label Text="No chats yet"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center" />
                            <Label Text="Tap the yellow button below to find and add friends."
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="#8E8E93"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Friend">
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,10" ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
                                </Grid.GestureRecognizers>

                                <!-- Avatar with dark ring -->
                                <Border Grid.Column="0"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        StrokeShape="RoundRectangle 30"
                                        Stroke="#262626"
                                        StrokeThickness="2"
                                        BackgroundColor="#000000"
                                        Padding="3"
                                        VerticalOptions="Center">
                                    <Border WidthRequest="50"
                                            HeightRequest="50"
                                            StrokeShape="RoundRectangle 25"
                                            StrokeThickness="0"
                                            BackgroundColor="#1C1C1E"
                                            Padding="0">
                                        <Grid>
                                            <Path Fill="#8E8E93"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Scale="1.05"
                                                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" />
                                            <Image Source="{Binding ProfilePictureUrl}"
                                                   IsVisible="{Binding ProfilePictureUrl, Converter={StaticResource IsStringNotNullOrWhiteSpaceConverter}}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- Friend Name & Last Message -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding DisplayName}"
                                           TextColor="#FFFFFF"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="17"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding LastMessagePreview}"
                                           TextColor="#8E8E93"
                                           FontFamily="OpenSansRegular"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Relative Time ("1h") -->
                                <Label Grid.Column="2"
                                       Text="{Binding LastMessageTimeText}"
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       VerticalOptions="Start"
                                       Margin="0,8,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Row 2: Bottom Spacer for Shared Persistent Bottom Bar -->
                <BoxView Grid.Row="2" HeightRequest="{Binding ChatBottomSpacerHeight}" BackgroundColor="Transparent" Color="Transparent" />

            </Grid>

        </Grid>

        <!-- ================================================================== -->
        <!-- SHARED PERSISTENT BOTTOM NAVIGATION PANEL (Camera/Feed & Chat/DM)  -->
        <!-- ================================================================== -->
        <Grid x:Name="SharedBottomBar"
              IsVisible="{Binding IsBottomBarVisible}"
              ColumnDefinitions="56, *, 56"
              Margin="{Binding SharedBottomBarMargin}"
              VerticalOptions="End">

            <!-- Left: 2x2 Grid Gallery Button (Visible in Feed View - Image 4) -->
            <Border Grid.Column="0"
                    IsVisible="{Binding ShowFeedSideButtonsInBottomBar}"
                    WidthRequest="48"
                    HeightRequest="48"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    BackgroundColor="#1C1C1E"
                    Padding="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenGridGalleryCommand}" />
                </Border.GestureRecognizers>
                <Grid WidthRequest="20" HeightRequest="20" RowDefinitions="*, *" ColumnDefinitions="*, *" RowSpacing="3" ColumnSpacing="3" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                    <Border Grid.Row="0" Grid.Column="0" Stroke="#FFFFFF" StrokeThickness="2" StrokeShape="RoundRectangle 2.5" BackgroundColor="Transparent" Padding="0" />
                    <Border Grid.Row="0" Grid.Column="1" Stroke="#FFFFFF" StrokeThickness="2" StrokeShape="RoundRectangle 2.5" BackgroundColor="Transparent" Padding="0" />
                    <Border Grid.Row="1" Grid.Column="0" Stroke="#FFFFFF" StrokeThickness="2" StrokeShape="RoundRectangle 2.5" BackgroundColor="Transparent" Padding="0" />
                    <Border Grid.Row="1" Grid.Column="1" Stroke="#FFFFFF" StrokeThickness="2" StrokeShape="RoundRectangle 2.5" BackgroundColor="Transparent" Padding="0" />
                </Grid>
            </Border>

            <!-- Center: Shared Floating 3-Tab Pill Bar -->
            <Border Grid.Column="1"
                    WidthRequest="190"
                    HeightRequest="56"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    BackgroundColor="#1C1C1E"
                    Padding="5"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Grid ColumnDefinitions="*, *, *">

                    <!-- Tab 0: Hamburger Menu Icon (Active Pill on Profile/Settings, Inactive Icon on Camera/Feed & Chat) -->
                    <Grid Grid.Column="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SnapToProfileCommand}" />
                        </Grid.GestureRecognizers>

                        <!-- Active Profile/Settings Pill -->
                        <Border IsVisible="{Binding IsProfilePanelActive}"
                                BackgroundColor="#3A3A3C"
                                StrokeShape="RoundRectangle 23"
                                StrokeThickness="0"
                                Padding="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <Path WidthRequest="20"
                                  HeightRequest="16"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2.4"
                                  StrokeLineCap="Round"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Data="M2,2 L18,2 M2,8 L18,8 M2,14 L18,14" />
                        </Border>

                        <!-- Inactive Hamburger Menu Icon -->
                        <Path IsVisible="{Binding IsNotProfilePanelActive}"
                              WidthRequest="20"
                              HeightRequest="16"
                              Stroke="#8E8E93"
                              StrokeThickness="2.4"
                              StrokeLineCap="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M2,2 L18,2 M2,8 L18,8 M2,14 L18,14" />
                    </Grid>

                    <!-- Tab 1 (Center): Active Home Pill (Camera) OR Inactive Home Icon (Chat) OR Mini Gold Shutter (Feed) -->
                    <Grid Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="Fill">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CenterBottomTabTappedCommand}" />
                        </Grid.GestureRecognizers>

                        <!-- Camera Mode: Active Home Pill -->
                        <Border IsVisible="{Binding ShowHomePillInBottomBar}"
                                BackgroundColor="#3A3A3C"
                                StrokeShape="RoundRectangle 23"
                                StrokeThickness="0"
                                Padding="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <Path WidthRequest="20"
                                  HeightRequest="21"
                                  Fill="#FFFFFF"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Data="M10,1.5 L1,8.5 L1,18.5 C1,19.3 1.7,20 2.5,20 L7.5,20 L7.5,13.5 C7.5,12.7 8.2,12 9,12 L11,12 C11.8,12 12.5,12.7 12.5,13.5 L12.5,20 L17.5,20 C18.3,20 19,19.3 19,18.5 L19,8.5 L10,1.5 Z" />
                        </Border>

                        <!-- Chat Mode: Inactive Home Icon -->
                        <Path IsVisible="{Binding ShowHomeIconInBottomBar}"
                              WidthRequest="20"
                              HeightRequest="21"
                              Fill="#8E8E93"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M10,1.5 L1,8.5 L1,18.5 C1,19.3 1.7,20 2.5,20 L7.5,20 L7.5,13.5 C7.5,12.7 8.2,12 9,12 L11,12 C11.8,12 12.5,12.7 12.5,13.5 L12.5,20 L17.5,20 C18.3,20 19,19.3 19,18.5 L19,8.5 L10,1.5 Z" />

                        <!-- Feed Mode: Mini Gold-Ring Shutter Button -->
                        <Grid IsVisible="{Binding ShowMiniShutterInBottomBar}"
                              WidthRequest="40"
                              HeightRequest="40"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">
                            <Border WidthRequest="38"
                                    HeightRequest="38"
                                    StrokeShape="RoundRectangle 19"
                                    Stroke="{DynamicResource AccentColor}"
                                    StrokeThickness="3"
                                    BackgroundColor="Transparent"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            <Border WidthRequest="28"
                                    HeightRequest="28"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    BackgroundColor="#FFFFFF"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <!-- Tab 2: Chat Bubble Icon (Active Pill on Chat, Inactive Icon on Camera/Feed) -->
                    <Grid Grid.Column="2" HorizontalOptions="Fill" VerticalOptions="Fill">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SnapToChatCommand}" />
                        </Grid.GestureRecognizers>

                        <!-- Active Chat Pill -->
                        <Border IsVisible="{Binding IsChatPanelActive}"
                                BackgroundColor="#3A3A3C"
                                StrokeShape="RoundRectangle 23"
                                StrokeThickness="0"
                                Padding="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <Path WidthRequest="20"
                                  HeightRequest="20"
                                  Fill="#FFFFFF"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Data="M10,1 C4.48,1 0,4.8 0,9.5 C0,11.6 0.9,13.5 2.4,15 L1,18.5 L5.2,16.9 C6.7,17.6 8.3,18 10,18 C15.52,18 20,14.2 20,9.5 C20,4.8 15.52,1 10,1 Z" />
                        </Border>

                        <!-- Inactive Chat Icon -->
                        <Path IsVisible="{Binding IsNotChatPanelActive}"
                              WidthRequest="20"
                              HeightRequest="20"
                              Fill="#8E8E93"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M10,1 C4.48,1 0,4.8 0,9.5 C0,11.6 0.9,13.5 2.4,15 L1,18.5 L5.2,16.9 C6.7,17.6 8.3,18 10,18 C15.52,18 20,14.2 20,9.5 C20,4.8 15.52,1 10,1 Z" />
                    </Grid>

                </Grid>
            </Border>

            <!-- Right (Feed Mode): More Options "..." Button -->
            <Border Grid.Column="2"
                    IsVisible="{Binding ShowFeedSideButtonsInBottomBar}"
                    WidthRequest="48"
                    HeightRequest="48"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    BackgroundColor="#1C1C1E"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePostOptionsMenuCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="4"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True">
                    <Ellipse WidthRequest="4.5" HeightRequest="4.5" Fill="#FFFFFF" />
                    <Ellipse WidthRequest="4.5" HeightRequest="4.5" Fill="#FFFFFF" />
                    <Ellipse WidthRequest="4.5" HeightRequest="4.5" Fill="#FFFFFF" />
                </HorizontalStackLayout>
            </Border>

            <!-- Right (Chat Mode): Floating Gold Circle Pencil Button (Active - Opens Add Friend / New Chat) -->
            <Border Grid.Column="2"
                    IsVisible="{Binding IsChatPanelActive}"
                    WidthRequest="56"
                    HeightRequest="56"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    BackgroundColor="{DynamicResource AccentColor}"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShellModel.AddFriendCommand}" />
                </Border.GestureRecognizers>
                <Path WidthRequest="22"
                      HeightRequest="22"
                      Fill="#000000"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Data="M2,16.2 L2,20 L5.8,20 L17,8.8 L13.2,5 L2,16.2 Z M19.7,6.1 C20.1,5.7 20.1,5.1 19.7,4.7 L17.3,2.3 C16.9,1.9 16.3,1.9 15.9,2.3 L14.1,4.1 L17.9,7.9 L19.7,6.1 Z" />
            </Border>

        </Grid>

        <!-- ================================================================== -->
        <!-- POST OPTIONS POPUP MENU OVERLAY (Triggered by "..." in Feed View)  -->
        <!-- ================================================================== -->
        <Grid x:Name="PostOptionsMenuOverlayGrid"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <!-- Backdrop to dismiss menu when tapping outside -->
            <BoxView x:Name="PostOptionsMenuBackdrop"
                     BackgroundColor="#55000000"
                     Color="#55000000"
                     Opacity="0"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPostOptionsMenuBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Floating Rounded Popup Card above the "..." Button -->
            <Border x:Name="PostOptionsMenuCard"
                    WidthRequest="200"
                    Margin="{Binding PostOptionsMenuMargin}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    BackgroundColor="#242426"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    Padding="0"
                    Opacity="0"
                    Scale="0.92">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <!-- Option 1: Download -->
                    <Grid ColumnDefinitions="26, *"
                          ColumnSpacing="14"
                          Padding="20,16"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DownloadCurrentFeedPostCommand}" />
                        </Grid.GestureRecognizers>
                        <Path Grid.Column="0"
                              WidthRequest="22"
                              HeightRequest="22"
                              Stroke="#D4D4D8"
                              StrokeThickness="2.4"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True"
                              Data="M11,3 L11,14 M6.5,9.5 L11,14 L15.5,9.5 M3.5,14 L3.5,16.5 C3.5,18.2 4.8,19.5 6.5,19.5 L15.5,19.5 C17.2,19.5 18.5,18.2 18.5,16.5 L18.5,14" />
                        <Label Grid.Column="1"
                               Text="Download"
                               TextColor="#E5E5EA"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="#3A3A3C"
                             Color="#3A3A3C"
                             Margin="18,0" />

                    <!-- Option 2: Delete -->
                    <Grid ColumnDefinitions="26, *"
                          ColumnSpacing="14"
                          Padding="20,16"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PromptDeleteCurrentFeedPostCommand}" />
                        </Grid.GestureRecognizers>
                        <!-- Filled Red Trash Icon with vertical cutouts -->
                        <Path Grid.Column="0"
                              WidthRequest="22"
                              HeightRequest="22"
                              Fill="#FF453A"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True"
                              Data="M8.5,2 C7.95,2 7.5,2.45 7.5,3 L7.5,4 L4,4 C3.45,4 3,4.45 3,5 C3,5.55 3.45,6 4,6 L18,6 C18.55,6 19,5.55 19,5 C19,4.45 18.55,4 18,4 L14.5,4 L14.5,3 C14.5,2.45 14.05,2 13.5,2 L8.5,2 Z M5,7.5 L5.7,18.2 C5.78,19.2 6.6,20 7.6,20 L14.4,20 C15.4,20 16.22,19.2 16.3,18.2 L17,7.5 L5,7.5 Z M9.2,10 C9.75,10 10.2,10.45 10.2,11 L10.2,16.5 C10.2,17.05 9.75,17.5 9.2,17.5 C8.65,17.5 8.2,17.05 8.2,16.5 L8.2,11 C8.2,10.45 8.65,10 9.2,10 Z M12.8,10 C13.35,10 13.8,10.45 13.8,11 L13.8,16.5 C13.8,17.05 13.35,17.5 12.8,17.5 C12.25,17.5 11.8,17.05 11.8,16.5 L11.8,11 C11.8,10.45 12.25,10 12.8,10 Z" />
                        <Label Grid.Column="1"
                               Text="Delete"
                               TextColor="#FF453A"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ================================================================== -->
        <!-- DELETE CONFIRMATION DIALOG OVERLAY                                 -->
        <!-- ================================================================== -->
        <Grid x:Name="DeleteConfirmOverlayGrid"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <!-- Darkened backdrop to dismiss dialog on tap outside -->
            <BoxView x:Name="DeleteConfirmBackdrop"
                     BackgroundColor="#78000000"
                     Color="#78000000"
                     Opacity="0"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDeleteConfirmBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Centered Rounded Dialog Card -->
            <Border x:Name="DeleteConfirmCard"
                    Margin="26,0"
                    MaximumWidthRequest="360"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    BackgroundColor="#1E1E20"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    Padding="26,24,26,20"
                    Opacity="0"
                    Scale="0.92">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Delete picture?"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <Label Text="{Binding DeleteConfirmDescription}"
                           TextColor="#D4D4D8"
                           FontFamily="OpenSansRegular"
                           FontSize="15.5"
                           LineHeight="1.25" />

                    <HorizontalStackLayout Spacing="28"
                                           HorizontalOptions="End"
                                           Margin="0,10,0,0">
                        <Grid Padding="8,6" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseDeleteConfirmCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Cancel"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16.5"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   InputTransparent="True" />
                        </Grid>

                        <Grid Padding="8,6" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeleteCurrentFeedPostCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Delete"
                                   TextColor="#FF453A"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16.5"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   InputTransparent="True" />
                        </Grid>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ================================================================== -->
        <!-- "SAVED" BOTTOM TOAST NOTIFICATION                                  -->
        <!-- ================================================================== -->
        <Border x:Name="SavedToastPill"
                IsVisible="False"
                Opacity="0"
                TranslationY="24"
                InputTransparent="True"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,90"
                BackgroundColor="#E62C2C2E"
                StrokeShape="RoundRectangle 22"
                StrokeThickness="0"
                Padding="20,11">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Path WidthRequest="16"
                      HeightRequest="13"
                      Stroke="#FFFFFF"
                      StrokeThickness="2.4"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      VerticalOptions="Center"
                      Data="M1.5,7 L5.5,11 L14.5,2" />
                <Label Text="Saved"
                       TextColor="#FFFFFF"
                       FontFamily="OpenSansSemibold"
                       FontSize="15.5"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- ================================================================== -->
        <!-- "COULDN'T SEND MESSAGE" BOTTOM TOAST NOTIFICATION                  -->
        <!-- ================================================================== -->
        <Border x:Name="SendFailedToastPill"
                IsVisible="False"
                Opacity="0"
                TranslationY="24"
                InputTransparent="True"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="16,0,16,90"
                BackgroundColor="#F02C2C2E"
                Stroke="#FF453A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="18,11">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Border WidthRequest="20"
                        HeightRequest="20"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#FF453A"
                        Padding="0"
                        VerticalOptions="Center">
                    <Label Text="!"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="Couldn't send message. Please try again later."
                       TextColor="#FFFFFF"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- ============================================================== -->
        <!-- NOTIFICATIONS FULL-SCREEN PANEL OVERLAY                        -->
        <!-- ============================================================== -->
        <Grid x:Name="NotificationsOverlayGrid"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <BoxView x:Name="NotificationsBackdrop"
                     BackgroundColor="#99000000"
                     Color="#99000000"
                     Opacity="0"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificationsBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="NotificationsSheetCard"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    Margin="0,24,0,0"
                    TranslationY="900"
                    BackgroundColor="#1C1C1E"
                    StrokeShape="RoundRectangle 32,32,0,0"
                    StrokeThickness="0"
                    Padding="16,12,16,32">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, *">
                    <!-- Drag Header Area: Handle pill + Title -->
                    <Grid Grid.Row="0"
                          RowDefinitions="Auto, Auto"
                          BackgroundColor="Transparent"
                          Padding="0,4,0,22">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnNotificationsSheetPanUpdated" />
                        </Grid.GestureRecognizers>

                        <BoxView Grid.Row="0"
                                 WidthRequest="38"
                                 HeightRequest="5"
                                 CornerRadius="2.5"
                                 Color="#5A5A5E"
                                 BackgroundColor="#5A5A5E"
                                 HorizontalOptions="Center"
                                 Margin="0,0,0,14">
                            <BoxView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationsBackdropTapped" />
                            </BoxView.GestureRecognizers>
                        </BoxView>

                        <Label Grid.Row="1"
                               Text="Notifications"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Grid>

                    <!-- Notification Toggles Card -->
                    <VerticalStackLayout Grid.Row="1" Spacing="0">
                        <Border BackgroundColor="#2C2C2E"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                Padding="20,6">
                            <VerticalStackLayout Spacing="0">
                                <!-- Reactions -->
                                <Grid ColumnDefinitions="*, Auto" Padding="0,12">
                                    <Label Grid.Column="0"
                                           Text="Reactions"
                                           TextColor="#FFFFFF"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1"
                                            WidthRequest="54"
                                            HeightRequest="32"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            BackgroundColor="{DynamicResource AccentColor}"
                                            Padding="3"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShellModel.ToggleReactionsNotificationCommand}" />
                                        </Border.GestureRecognizers>
                                        <Border WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeShape="RoundRectangle 13"
                                                StrokeThickness="0"
                                                BackgroundColor="#FFFFFF"
                                                Padding="0"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsReactionsNotificationEnabled}" Value="False">
                                                    <Setter Property="HorizontalOptions" Value="Start" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsReactionsNotificationEnabled}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#3A3A3C" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Grid>

                                <!-- Messages -->
                                <Grid ColumnDefinitions="*, Auto" Padding="0,12">
                                    <Label Grid.Column="0"
                                           Text="Messages"
                                           TextColor="#FFFFFF"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1"
                                            WidthRequest="54"
                                            HeightRequest="32"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            BackgroundColor="{DynamicResource AccentColor}"
                                            Padding="3"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShellModel.ToggleMessagesNotificationCommand}" />
                                        </Border.GestureRecognizers>
                                        <Border WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeShape="RoundRectangle 13"
                                                StrokeThickness="0"
                                                BackgroundColor="#FFFFFF"
                                                Padding="0"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsMessagesNotificationEnabled}" Value="False">
                                                    <Setter Property="HorizontalOptions" Value="Start" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding ShellModel.IsMessagesNotificationEnabled}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#3A3A3C" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- CONNECTION FULL-SCREEN PANEL OVERLAY                           -->
        <!-- ============================================================== -->
        <Grid x:Name="ConnectionOverlayGrid"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <BoxView x:Name="ConnectionBackdrop"
                     BackgroundColor="#99000000"
                     Color="#99000000"
                     Opacity="0"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConnectionBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="ConnectionSheetCard"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    Margin="0,24,0,0"
                    TranslationY="900"
                    BackgroundColor="#1C1C1E"
                    StrokeShape="RoundRectangle 32,32,0,0"
                    StrokeThickness="0"
                    Padding="16,12,16,32">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Drag Header Area: Handle pill + Title -->
                    <Grid Grid.Row="0"
                          RowDefinitions="Auto, Auto"
                          BackgroundColor="Transparent"
                          Padding="0,4,0,22">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnConnectionSheetPanUpdated" />
                        </Grid.GestureRecognizers>

                        <BoxView Grid.Row="0"
                                 WidthRequest="38"
                                 HeightRequest="5"
                                 CornerRadius="2.5"
                                 Color="#5A5A5E"
                                 BackgroundColor="#5A5A5E"
                                 HorizontalOptions="Center"
                                 Margin="0,0,0,14">
                            <BoxView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConnectionBackdropTapped" />
                            </BoxView.GestureRecognizers>
                        </BoxView>

                        <Label Grid.Row="1"
                               Text="Connection"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="14">
                            <!-- Current status -->
                            <Border BackgroundColor="#2C2C2E"
                                    StrokeShape="RoundRectangle 22"
                                    StrokeThickness="0"
                                    Padding="20,14">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="0" BackgroundColor="{Binding ShellModel.ConnectionStatusColor}" Padding="0" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding ShellModel.ConnectionStatusText}" TextColor="{Binding ShellModel.ConnectionStatusColor}" FontFamily="OpenSansSemibold" FontSize="14" FontAttributes="Bold" />
                                        <Label TextColor="#8E8E93" FontFamily="OpenSansRegular" FontSize="13" LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ShellModel.ConnectionServerTitle}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding ShellModel.ConnectionServerAddress}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding ShellModel.ConnectedAtText}" TextColor="#8E8E93" FontSize="12" VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Primary server -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Primary"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       Margin="4,0,0,0" />
                                <Border BackgroundColor="#2C2C2E"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        Padding="14,0"
                                        HeightRequest="50">
                                    <Entry x:Name="PrimaryServerEntry"
                                           Text="{Binding ShellModel.ServerIp}"
                                           Placeholder="IP or URL (e.g. https://pc.example.ts.net)"
                                           Keyboard="Url"
                                           PlaceholderColor="#8E8E93"
                                           TextColor="White"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Secondary server -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Secondary"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       Margin="4,0,0,0" />
                                <Border BackgroundColor="#2C2C2E"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        Padding="14,0"
                                        HeightRequest="50">
                                    <Entry x:Name="SecondaryServerEntry"
                                           Text="{Binding ShellModel.SecondaryServerIp}"
                                           Placeholder="IP or URL (leave empty to disable)"
                                           Keyboard="Url"
                                           PlaceholderColor="#8E8E93"
                                           TextColor="White"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                </Border>
                                <Label Text="Used automatically when the primary server is unreachable."
                                       TextColor="#8E8E93"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       Margin="4,0,0,0" />
                            </VerticalStackLayout>

                            <!-- Connection history: timeline of drops, failovers and returns (most recent first) -->
                            <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                                <Label Text="History"
                                       TextColor="#FFFFFF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       Margin="4,0,0,0" />
                                <Border BackgroundColor="#2C2C2E"
                                        StrokeShape="RoundRectangle 22"
                                        StrokeThickness="0"
                                        Padding="16,14">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ShellModel.ConnectionHistory}">
                                        <BindableLayout.EmptyView>
                                            <Label Text="No connection events yet."
                                                   TextColor="#8E8E93"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="13"
                                                   HorizontalOptions="Center" />
                                        </BindableLayout.EmptyView>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ConnectionEvent">
                                                <Grid ColumnDefinitions="18, *, Auto" ColumnSpacing="10">
                                                    <!-- Timeline rail + dot -->
                                                    <BoxView Grid.Column="0"
                                                             WidthRequest="2"
                                                             Color="#3A3A3C"
                                                             BackgroundColor="#3A3A3C"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Fill" />
                                                    <Border Grid.Column="0"
                                                            WidthRequest="12"
                                                            HeightRequest="12"
                                                            Margin="0,4,0,0"
                                                            StrokeShape="RoundRectangle 6"
                                                            Stroke="#2C2C2E"
                                                            StrokeThickness="2"
                                                            BackgroundColor="{Binding ColorHex}"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Start" />

                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="0,0,0,14">
                                                        <Label Text="{Binding Title}"
                                                               TextColor="{Binding ColorHex}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="14"
                                                               FontAttributes="Bold" />
                                                        <Label Text="{Binding Subtitle}"
                                                               TextColor="#8E8E93"
                                                               FontFamily="OpenSansRegular"
                                                               FontSize="12"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding Detail}"
                                                               IsVisible="{Binding HasDetail}"
                                                               TextColor="#6E6E73"
                                                               FontFamily="OpenSansRegular"
                                                               FontSize="12"
                                                               MaxLines="2"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>

                                                    <Label Grid.Column="2"
                                                           Text="{Binding TimeText}"
                                                           TextColor="#8E8E93"
                                                           FontFamily="OpenSansRegular"
                                                           FontSize="12"
                                                           VerticalOptions="Start"
                                                           Margin="0,2,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Save button -->
                    <Border Grid.Row="2"
                            Margin="0,16,0,0"
                            HeightRequest="54"
                            StrokeShape="RoundRectangle 27"
                            StrokeThickness="0"
                            BackgroundColor="{DynamicResource AccentColor}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SaveConnectionSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Save"
                               TextColor="#000000"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Full-screen white overlay for front-camera / no-hardware-flash "screen flash" -->
        <BoxView x:Name="ScreenFlashOverlay"
                 IsVisible="False"
                 Opacity="0"
                 BackgroundColor="#FFFFFF"
                 Color="#FFFFFF"
                 InputTransparent="True"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        </Grid>
    </controls:HorizontalSwipeView>
</ContentPage>
